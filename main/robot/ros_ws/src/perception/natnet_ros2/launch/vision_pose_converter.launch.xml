<?xml version="1.0"?>
<launch>
  <!--
    Vision Pose Converter Launch File

    Optional bridge that re-publishes a NatNet pose_cov topic on the MAVROS
    vision_pose topics so PX4 can fuse external pose estimates.

    Static params (frame_id, child_frame_id, default use_sim_time): config/vision_pose_converter.yaml
    Topics are supplied by natnet_ros2.launch.py from the robot's vision_pose block
    in natnet_config.yaml (absolute, already namespaced under /{ROBOT_NAME}/):

      input_topic            (from NatNet node, PoseWithCovarianceStamped)
      output_pose_topic      (to MAVROS, PoseStamped)
      output_pose_cov_topic  (to MAVROS, PoseWithCovarianceStamped)
  -->

  <arg name="config_file"
       default="$(find-pkg-share natnet_ros2)/config/vision_pose_converter.yaml"
       description="ROS 2 parameter YAML (/** ros__parameters block)"/>

  <arg name="input_topic"
       default="/$(env ROBOT_NAME robot_1)/perception/optitrack/drone/pose_cov"
       description="NatNet pose_cov topic to bridge to MAVROS"/>
  <arg name="output_pose_topic"
       default="/$(env ROBOT_NAME robot_1)/interface/mavros/vision_pose/pose"
       description="MAVROS vision_pose PoseStamped output topic"/>
  <arg name="output_pose_cov_topic"
       default="/$(env ROBOT_NAME robot_1)/interface/mavros/vision_pose/pose_cov"
       description="MAVROS vision_pose PoseWithCovarianceStamped output topic"/>

  <!-- Overrides vision_pose_converter.yaml use_sim_time when launching from sim -->
  <arg name="use_sim_time" default="false"
       description="Forwarded after YAML so sim stacks can force true"/>

  <node pkg="natnet_ros2" exec="vision_pose_converter_node.py"
        name="vision_pose_converter" output="screen">
    <param from="$(var config_file)" allow_substs="true"/>

    <param name="input_topic" value="$(var input_topic)"/>
    <param name="output_pose_topic" value="$(var output_pose_topic)"/>
    <param name="output_pose_cov_topic" value="$(var output_pose_cov_topic)"/>

    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

</launch>
