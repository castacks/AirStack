# This is the main .env file for AirStack, which sets DOCKER COMPOSE VARIABLES FOR VARIABLE INTERPOLATION IN docker-compose.yaml.
# These variables do NOT get set within the robot container itself. For setting container environment variables, use env_file: attribute in docker-compose.yaml.
# Standard Usage: airstack up   (reads this file automatically; flags like --sim/--robots override it — see `airstack help up`)

# Warning: even though this file is organized into sections, all variables get propagated to all sub-level 
#  docker-compose files, so be careful about naming conflicts.

# =============== PROJECT ====================
# THESE VARIABLES ARE USED TO TAG THE DOCKER IMAGES.
# The name of the project. This is used as the repository name for the docker images, and also as part of the default image tag.
PROJECT_NAME="airstack"
# If you've run ./airstack.sh setup, then this will auto-generate from the git commit hash every time a change is made 
# to a Dockerfile or docker-compose.yaml file. Otherwise this can also be set explicitly to make a release version.
# auto-generated from git commit hash
VERSION="0.21.0-dev.15"
# Image-tag discriminator ONLY (appears in the image tag suffix, e.g. ..._robot-x86-64_dev).
# No Dockerfile consumes it: "prebuilt" does NOT bake the built ros_ws into the image today —
# a real prebuilt (workspace-baked) stage is future work. Keep "dev" (mounted code, built live).
DOCKER_IMAGE_BUILD_MODE="dev"
# Where to push and pull images from. Can replace with your docker hub username if using docker hub.
PROJECT_DOCKER_REGISTRY="airlab-docker.andrew.cmu.edu/airstack"
# This is the default profile that docker compose will use if you just run `docker compose up` without specifying a profile. 
# It can be overridden with the --profile flag, or by setting the COMPOSE_PROFILES environment variable to a different value
#  before running `docker compose up`.
COMPOSE_PROFILES="desktop,isaac-sim"
# ============================================

# ================= Common ===================
AUTOLAUNCH="true"  # If false, the docker-compose will just spawn idle docker containers with no launch command.
NUM_ROBOTS="1"  # Number of robot containers to launch.
RECORD_BAGS="false"  # "true" or "false"

# ============== DATASET =======================
# Where the FROZEN scenes live — one self-contained USD, a Materials/ folder and
# the two ground-truth files per cell. Bind-mounted into the isaac-sim container
# at /isaac-sim/final_disaster_dataset, and deliberately OUTSIDE the repo: at the
# full 4 x 2 x 3 x 5 matrix this is hundreds of MB a scene, which has no business
# sitting in the working tree.
FINAL_DATASET_DIR="${HOME}/SEI-COA/final_disaster_dataset"
# Asset packs a frozen cell's materials reference (scene_gen/assets of the checkout
# that built it). Mounted read-only into isaac-sim at /isaac-sim/AirStack/scene_gen/assets.
# SCENE_ASSETS_DIR="${HOME}/SEI-COA/disaster-dataset/scene_gen/assets"

# ============== RULES PLANNER =================
# The rules_planner stack (stacks/rules_planner). Uncomment to run the demo;
# robot-base-docker-compose.yaml forwards each of these into the robot
# containers, and a var missing from that list never reaches the launch file.
#
# RULES_PLANNER is the fleet-wide on/off for the planner; RULES_PLANNER_ROBOT
# picks WHICH container runs it. It has to be a name and not a per-robot flag:
# the robot containers are compose REPLICAS of one service, so they all read
# this same file. The executor runs on every robot.
#RULES_PLANNER="true"
#RULES_PLANNER_ROBOT="robot_1"
#RULES_EXECUTOR="true"          # per-robot task executor; REPLACES random_walk
#RULES_DASHBOARD="true"         # http://localhost:8791 on the planner's robot
#RULES_DASHBOARD_PORT="8791"
#RULES_TRACK_SPACING_M="25.0"   # lawnmower spacing for sweep/survey polygons
#RULES_AUTO_TAKEOFF="true"
#RULES_TAKEOFF_ALTITUDE_M="10.0"
#RULES_LLM_BACKEND="openai"     # "fake" = no model, scripted AOEs
#RULES_LLM_MODEL="qwen2.5:7b-instruct"
# The host's Ollama, from inside a robot container. robot_base maps
# host.docker.internal to the docker host; 172.31.0.1 (the airstack_network
# gateway) is the explicit spelling of the same thing.
#OPENAI_BASE_URL="http://host.docker.internal:11434/v1"
# The cell's ground truth AS THE ROBOT CONTAINER SEES IT, for the
# /dtc/rules_planner/gt_people layer. Empty = no GT layer.
#RULES_GT_PEOPLE="/root/final_disaster_dataset/Earthquake/Suburban500/level_1/1/GT_people.json"
#RAYFRONTS_EMB="true"           # the mapper's emb/* export the planner reads
# Foxglove layout the GCS renders and seeds (unset = airstack_default.json).
#LAYOUT_TEMPLATE="/root/AirStack/gcs/foxglove_extensions/rules_planner.json"
# ===============================================

# ============== ISAAC SIM =====================
ISAAC_SIM_GUI="/isaac-sim/AirStack/simulation/isaac-sim/assets/scenes/simple_pegasus.scene.usd"
# Set to "true" to launch Isaac Sim using a standalone Python script instead of USD file
ISAAC_SIM_USE_STANDALONE="true" # "true" or "false"
# Script name (must be in /AirStack/simulation/isaac-sim/launch_scripts/)
ISAAC_SIM_SCRIPT_NAME="example_one_px4_pegasus_launch_script.py"
PLAY_SIM_ON_START="true"  # Sim starts PLAYING by default (launch with `airstack up --no-play` to come up paused).
# Scene to load, set by `airstack up --scene <shortname>` (see simulation/scenes.yaml
# for shortnames). Can also be set directly to a Pegasus SIMULATION_ENVIRONMENTS
# key or a USD URL. Empty = the launch script's default (Default Environment).
# ISAAC_SIM_SCENE="Warehouse"
# ISAAC_SIM_STAGE_SCALE="1.0"  # scale applied to /World/stage (0.01 for cm-authored stages)

# --- FROZEN DATASET CELL (example_multi_drone_scene_import.py) ---------------
# A frozen cell is a finished scene: one .usd plus Materials/, GT_hints.json,
# GT_people.json and freeze_report.json, produced on the krrishj/disaster-dataset
# branch by scene_gen/disaster/freeze.py. This branch carries the LOADER only —
# scene_gen/ was not ported, so SCENE_CONFIG exits with a message rather than
# trying to build a plat.
#
# Select the launcher and the cell. FROZEN_SCENE is a BARE CELL PATH relative to
# FROZEN_DATASET_ROOT (the filename inside it is derived from the dataset
# contract), so the same string works against the bind mount and against Nucleus:
#   /isaac-sim/final_disaster_dataset                 the mount (the default;
#                                                     host side FINAL_DATASET_DIR)
#   omniverse://<host>/Projects/SEI-COA/final_disaster_dataset
#                                                     Nucleus — the only option
#                                                     on a pod, which has no
#                                                     local copy of the cells
#ISAAC_SIM_SCRIPT_NAME="example_multi_drone_scene_import.py"
#FROZEN_SCENE="Earthquake/Suburban500/level_1/1"
#FROZEN_DATASET_ROOT=""           # empty = /isaac-sim/final_disaster_dataset
#FROZEN_OVERLAY_USD=""            # extra authored layer at /World/Overlay
#REGION_M="500x500"               # sizes the overhead camera and the search rect
#NUM_ROBOTS="3"
#
# THREE DRONES on the 500 m plate, 6 m apart on the same kerb, same heading.
# SPAWN_CONFIGS is a JSON list needing only x_m/y_m; domain_id defaults to the
# list index (robot_1..3), z_m to SPAWN_HEIGHT_M, orient to identity (+X/east).
# GENERATED/FROZEN paths only — the ENV_URL fleet is the list in the script.
# VERIFY AGAINST THE CELL before flying it: a suburb plate puts houses, kerbs
# and yard trees near the origin, and these three are the plate centre, not a
# surveyed clearing. The cell's GT_hints.json carries the obstacle boxes.
#SPAWN_CONFIGS='[{"x_m": -6.0, "y_m": 0.0}, {"x_m": 0.0, "y_m": 0.0}, {"x_m": 6.0, "y_m": 0.0}]'
#SPAWN_HEIGHT_M="0.5"
#SPAWN_POLY=""                    # alternative: randomise NUM_ROBOTS spawns in
#SPAWN_SEED=""                    # a rect ([[x0,y0],[x1,y1]]) or convex polygon
#SPAWN_MIN_DIST_M="3.0"
#SPAWN_MARGIN_M="0.0"
#
# Colliders on the plat. off | ground | all. BARE default is 'ground' — the
# 1,800-mesh ground sheet the drone lands on; 'all' cooks exact triangle meshes
# for every merged debris field (minutes, but the only mode a low flight can
# trust); 'off' leaves the cell's own collision APIs and Pegasus' ground plane.
#SUBURB_COLLIDERS="ground"
#
# Ground truth. RESULTS_SCENE names the annotation files the loader writes out
# of the cell's GT_hints.json / GT_people.json, into
# gcs/ros_ws/src/gcs_visualizer/annotations/ (and raven_nav/annotations/ where
# that module is checked out). Writing is skipped for a directory that does not
# exist, so an unset RESULTS_SCENE is silent, not an error.
#GT_ANNOTATIONS="on"
#RESULTS_SCENE="EarthquakeSuburban500L1"
#
# FROZEN-CELL LIGHTING. A cell ships no sky: freeze.DEACTIVATE_DEFAULT turns off
# /World/Environment before the flatten so the collector does not drag the
# default environment along, and the sun and sky live in exactly that prim.
# Nothing puts it back, so the loader authors a dome + sun over the cell. All
# optional and safe empty — the loader reads them as `get(X) or <default>`.
#FROZEN_LIGHT="on"
#FROZEN_SKY=""                    # default: RetroNeighborhood.stage.usd on Nucleus
#FROZEN_DOME_INTENSITY="1200"     # only used if the sky cannot be borrowed
#FROZEN_DOME_EXPOSURE="0"
#FROZEN_SUN="on"                  # added only if the sky brought no DistantLight
#FROZEN_SUN_INTENSITY="2400"
#FROZEN_SUN_ELEV_DEG="48"         # up from the horizon
#FROZEN_SUN_AZ_DEG="135"          # clockwise from +Y (north)
#FROZEN_KILL_STRAY_LIGHTS="on"    # the 0.25 m bulb at the origin inside the
#                                 # search area, left over from the default env
#
# FROZEN-CELL ASSET REBASE. A cell's textures are baked as ABSOLUTE paths inside
# the build container, and scene_gen/assets/{aec,objaverse,materials/scorched}
# are git-ignored — so a checkout without the build tree resolves none of them
# and the ground renders untextured. The loader repoints any path that is
# genuinely ABSENT locally onto the Nucleus mirror, which makes this a no-op on
# the machine that built the cell and a fix everywhere else.
#FROZEN_REBASE_ASSETS="on"
#FROZEN_ASSET_LOCAL_PREFIX="/isaac-sim/AirStack/scene_gen/assets/"
#FROZEN_ASSET_MIRROR=""           # default: Projects/SEI-COA/scene_gen/assets/
#
# Renderer/physics device. One RTX card: leave ACTIVE_GPU at 0 and MULTIGPU off.
# CUDA_VISIBLE_DEVICES is deliberately NOT set here — pinning CUDA's view
# desynchronises it from Omniverse's own device table and Kit falls back to
# software rendering while nvidia-smi still lists the card.
#ISAAC_SIM_ACTIVE_GPU="0"
#ISAAC_SIM_GPU_PHYSICS="false"
#ISAAC_SIM_MULTIGPU=""

# ===============================================

# ================= MS-AIRSIM =====================
# Scene to run, set by `airstack up --scene <shortname>` (see simulation/scenes.yaml).
# A fetch_scene.sh key; the pre-built UE4 binary is auto-fetched if absent.
# Empty = blocks. Ignored when MS_AIRSIM_BINARY_PATH is set.
# MS_AIRSIM_SCENE="blocks"
# Do not set if you want airstack to fetch a simple blocks world.
# MS_AIRSIM_ENV_DIR=./simulation/ms-airsim/assets/scenes
# MS_AIRSIM_BINARY_PATH="/ms-airsim-env/Blocks/LinuxNoEditor/Blocks.sh"
# =================================================

# ================= ROBOT =====================
ROBOT_NAME_MAP_CONFIG_FILE="default_robot_name_map.yaml"  # Determines how to set ROBOT_NAME and ROS_DOMAIN_ID. See robot/docker/robot_name_map/

URDF_FILE="robot_descriptions/iris/urdf/iris_with_sensors.pegasus.robot.urdf"

DEBUG_RVIZ="false"  # "true" or "false". If true, launches RViz alongside the robot via desktop_bringup/robot.launch.xml.

# offboard API streaming out. this is so that ports don't conflict for multi-agent FCU communication. 
OFFBOARD_BASE_PORT=14540
ONBOARD_BASE_PORT=14580
