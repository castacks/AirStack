<?xml version="1.0" encoding="UTF-8" ?>

<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles" >
    <!-- LARGE_DATA builtin mode: UDP multicast for discovery, TCP (+ SHM
         between same-version participants) for user data. Chosen because:
         - large image messages (~600KB/frame) over UDP lose whole frames to
           socket-buffer overflow crossing the docker bridge (kernel caps not
           raisable on OSMO pods), and RELIABLE writers then retransmit-storm
           (observed ~570MB/s on the bridge for ~47MB/s of payload);
         - SHM interoperability depends on the actual mapped DDS libraries
           and IPC setup. Some Isaac releases bundle a different DDS; the
           observed 0.19 deployment instead maps Jazzy Fast DDS 2.14.6.
           Inspect runtime maps rather than assuming a bundled version.
           RTPS-over-TCP remains version-interoperable.
         Requires every stack container to bind-mount the same host /dev/shm
         (see compose files) for the SHM part; TCP needs nothing special. -->
    <participant profile_name="large_data_profile" is_default_profile="true">
        <rtps>
            <builtinTransports>LARGE_DATA</builtinTransports>
        </rtps>
    </participant>
</profiles>
