<!-- MAVROS bringup for PX4: wraps the upstream mavros node.launch with the
     AirStack px4_config.yaml and PX4 plugin list.
     Included by: interface.launch.py (which pushes the interface namespace and
     computes fcu_url / tgt_system).
     STATUS: canonical module launch (included by stacks via
     interface.launch.py). -->
<launch>
  <arg name="fcu_url" default="/dev/ttyACM0:57600"
       description="MAVLink FCU connection URL (serial device, tcp://, or udp://)" />
  <arg name="gcs_url" default=""
       description="Optional MAVLink GCS bridge URL (empty = no bridge)" />
  <arg name="tgt_system" default="1"
       description="MAVLink target system id (1 + ROS_DOMAIN_ID in sim)" />
  <arg name="tgt_component" default="1"
       description="MAVLink target component id" />
  <arg name="log_output" default="screen"
       description="MAVROS log output destination" />
  <arg name="fcu_protocol" default="v2.0"
       description="MAVLink protocol version" />
  <arg name="respawn_mavros" default="false"
       description="Respawn the MAVROS node if it dies" />
  <arg name="namespace" default="mavros"
       description="Namespace for the MAVROS node" />

  <include file="$(find-pkg-share mavros)/launch/node.launch">
    <arg name="pluginlists_yaml" value="$(find-pkg-share mavros)/launch/px4_pluginlists.yaml" />
    <arg name="config_yaml" value="$(find-pkg-share interface_bringup)/config/px4_config.yaml" />
    <arg name="fcu_url" value="$(var fcu_url)" />
    <arg name="gcs_url" value="$(var gcs_url)" />
    <arg name="tgt_system" value="$(var tgt_system)" />
    <arg name="tgt_component" value="$(var tgt_component)" />
    <arg name="log_output" value="$(var log_output)" />
    <arg name="fcu_protocol" value="$(var fcu_protocol)" />
    <arg name="respawn_mavros" value="$(var respawn_mavros)" />
    <arg name="namespace" value="$(var namespace)"/>
  </include>
</launch>
