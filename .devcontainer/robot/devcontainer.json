{
  "name": "Robot Container",
  "runServices": [
    "robot-desktop"
  ],
  "dockerComposeFile": [
    "../../docker-compose.yaml"
  ],
  "service": "robot-desktop",
  "workspaceFolder": "/root/AirStack",
  "customizations": {
    "vscode": {
      "extensions": [
        "Ranch-Hand-Robotics.rde-pack",
        "ms-vscode.cpptools",
        "ms-python.black-formatter",
        "ms-vscode.cmake-tools"
      ],
    }
  },
  "containerEnv": {
    "AUTOLAUNCH": "false"
  }
}