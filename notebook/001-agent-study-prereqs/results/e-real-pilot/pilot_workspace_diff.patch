+#!/usr/bin/env python3
+"""route_planner_alpha — straight-segment waypoint route planner.
+
+Written fresh for the agent study (prerequisite P-2). Deliberately not
+derived from, or structured like, any existing open-source planner: study
+subjects must integrate it, not recall it.
+
+Behavior: on the first odometry sample the configured route is anchored
+relative to the robot's pose (x forward along heading, z up), unless
+``relative`` is false, in which case waypoints are taken verbatim in the
+odometry frame. At ``replan_rate_hz`` the node publishes a dense
+``nav_msgs/Path`` from the robot's current position straight through the
+remaining waypoints. A waypoint is retired once the robot passes within
+``arrival_radius_m`` of it. After the last waypoint is retired the node
+keeps publishing a single-pose path holding the final waypoint.
+
+Runs standalone:
+    python3 planner_a.py --ros-args -p route:="30,0,10; 30,30,10; 0,30,10"
+
+See CONTRACT.md (same directory) for the full integration contract.
+"""
+
+import math
+
+import rclpy
+from geometry_msgs.msg import PoseStamped
+from nav_msgs.msg import Odometry, Path
+from rclpy.node import Node
+
+NODE_NAME = "route_planner_alpha"
+
+
+def parse_route(spec: str):
+    """Parse ``"x,y,z; x,y,z; ..."`` into a list of (x, y, z) tuples."""
+    points = []
+    for chunk in spec.split(";"):
+        chunk = chunk.strip()
+        if not chunk:
+            continue
+        parts = [p.strip() for p in chunk.split(",")]
+        if len(parts) != 3:
+            raise ValueError(f"route waypoint {chunk!r} is not 'x,y,z'")
+        points.append(tuple(float(p) for p in parts))
+    if not points:
+        raise ValueError("route is empty")
+    return points
+
+
+def yaw_from_quaternion(x: float, y: float, z: float, w: float) -> float:
+    return math.atan2(2.0 * (w * z + x * y), 1.0 - 2.0 * (y * y + z * z))
+
+
+def anchor_route(points, px, py, pz, yaw):
+    """Rotate route by yaw and translate by (px, py, pz)."""
+    c, s = math.cos(yaw), math.sin(yaw)
+    return [(px + x * c - y * s, py + x * s + y * c, pz + z)
+            for x, y, z in points]
+
+
+def straight_dense_path(points, spacing: float):
+    """Linear interpolation through ``points`` at ~``spacing`` intervals."""
+    dense = [points[0]]
+    for (ax, ay, az), (bx, by, bz) in zip(points, points[1:]):
+        seg = math.dist((ax, ay, az), (bx, by, bz))
+        steps = max(1, math.ceil(seg / spacing))
+        for i in range(1, steps + 1):
+            f = i / steps
+            dense.append((ax + (bx - ax) * f,
+                          ay + (by - ay) * f,
+                          az + (bz - az) * f))
+    return dense
+
+
+class RoutePlannerAlpha(Node):
+    def __init__(self):
+        super().__init__(NODE_NAME)
+        self.declare_parameter("route", "")
+        self.declare_parameter("relative", True)
+        self.declare_parameter("spacing_m", 1.0)
+        self.declare_parameter("arrival_radius_m", 2.0)
+        self.declare_parameter("replan_rate_hz", 2.0)
+
+        route_spec = self.get_parameter("route").value
+        if not route_spec:
+            raise SystemExit(f"{NODE_NAME}: required parameter 'route' is empty")
+        self._route_body = parse_route(route_spec)
+        self._route_world = None   # anchored on first odometry
+        self._next_idx = 0
+        self._last_odom = None
+
+        self._path_pub = self.create_publisher(Path, "~/planned_path", 10)
+        self._odom_sub = self.create_subscription(
+            Odometry, "~/odom_in", self._on_odom, 10)
+        rate = float(self.get_parameter("replan_rate_hz").value)
+        self._timer = self.create_timer(1.0 / max(rate, 0.1), self._replan)
+        self.get_logger().info(
+            f"{NODE_NAME} up with {len(self._route_body)} waypoints; "
+            f"waiting for odometry on ~/odom_in")
+
+    # ── callbacks ──────────────────────────────────────────────────────
+
+    def _on_odom(self, msg: Odometry):
+        self._last_odom = msg
+        if self._route_world is None:
+            p = msg.pose.pose.position
+            q = msg.pose.pose.orientation
+            if self.get_parameter("relative").value:
+                yaw = yaw_from_quaternion(q.x, q.y, q.z, q.w)
+                self._route_world = anchor_route(
+                    self._route_body, p.x, p.y, p.z, yaw)
+            else:
+                self._route_world = list(self._route_body)
+            self.get_logger().info(
+                "route anchored: "
+                + "; ".join(f"({x:.1f}, {y:.1f}, {z:.1f})"
+                            for x, y, z in self._route_world))
+
+    def _replan(self):
+        if self._last_odom is None or self._route_world is None:
+            return
+        p = self._last_odom.pose.pose.position
+        pos = (p.x, p.y, p.z)
+
+        radius = float(self.get_parameter("arrival_radius_m").value)
+        while (self._next_idx < len(self._route_world)
+               and math.dist(pos, self._route_world[self._next_idx]) < radius):
+            self.get_logger().info(f"waypoint {self._next_idx} reached")
+            self._next_idx += 1
+
+        remaining = self._route_world[self._next_idx:]
+        if remaining:
+            spacing = float(self.get_parameter("spacing_m").value)
+            points = straight_dense_path([pos] + remaining, spacing)
+        else:
+            points = [self._route_world[-1]]  # hold the final waypoint
+
+        self._publish_path(points)
+
+    # ── helpers ────────────────────────────────────────────────────────
+
+    def _publish_path(self, points):
+        msg = Path()
+        msg.header.stamp = self.get_clock().now().to_msg()
+        msg.header.frame_id = self._last_odom.header.frame_id
+        for x, y, z in points:
+            pose = PoseStamped()
+            pose.header = msg.header
+            pose.pose.position.x = x
+            pose.pose.position.y = y
+            pose.pose.position.z = z
+            pose.pose.orientation.w = 1.0
+            msg.poses.append(pose)
+        self._path_pub.publish(msg)
+
+
+def main():
+    rclpy.init()
+    node = RoutePlannerAlpha()
+    try:
+        rclpy.spin(node)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        node.destroy_node()
+        rclpy.try_shutdown()
+
+
+if __name__ == "__main__":
+    main()
