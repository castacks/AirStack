+#!/usr/bin/env python3
+"""route_planner_beta — spline-smoothed waypoint route planner.
+
+Written fresh for the agent study (prerequisite P-2). Same integration
+contract as route_planner_alpha (see CONTRACT.md) but visibly different
+output: instead of straight segments, the published path is a centripetal
+Catmull-Rom spline through the robot's position and the remaining
+waypoints, so corners become smooth curves. Used as the "second planner"
+in ladder rung R6 (planner swap).
+
+Runs standalone:
+    python3 planner_b.py --ros-args -p route:="30,0,10; 30,30,10; 0,30,10"
+"""
+
+import math
+
+import rclpy
+from geometry_msgs.msg import PoseStamped
+from nav_msgs.msg import Odometry, Path
+from rclpy.node import Node
+
+NODE_NAME = "route_planner_beta"
+
+
+def parse_route(spec: str):
+    """Parse ``"x,y,z; x,y,z; ..."`` into a list of (x, y, z) tuples."""
+    points = []
+    for chunk in spec.split(";"):
+        chunk = chunk.strip()
+        if not chunk:
+            continue
+        parts = [p.strip() for p in chunk.split(",")]
+        if len(parts) != 3:
+            raise ValueError(f"route waypoint {chunk!r} is not 'x,y,z'")
+        points.append(tuple(float(p) for p in parts))
+    if not points:
+        raise ValueError("route is empty")
+    return points
+
+
+def yaw_from_quaternion(x: float, y: float, z: float, w: float) -> float:
+    return math.atan2(2.0 * (w * z + x * y), 1.0 - 2.0 * (y * y + z * z))
+
+
+def anchor_route(points, px, py, pz, yaw):
+    """Rotate route by yaw and translate by (px, py, pz)."""
+    c, s = math.cos(yaw), math.sin(yaw)
+    return [(px + x * c - y * s, py + x * s + y * c, pz + z)
+            for x, y, z in points]
+
+
+def _catmull_rom_segment(p0, p1, p2, p3, n: int):
+    """Sample n points on the centripetal Catmull-Rom arc from p1 to p2."""
+    def tj(ti, a, b):
+        return ti + math.dist(a, b) ** 0.5
+
+    t0 = 0.0
+    t1 = tj(t0, p0, p1)
+    t2 = tj(t1, p1, p2)
+    t3 = tj(t2, p2, p3)
+    # Degenerate spacing (coincident control points) → straight segment.
+    if not (t0 < t1 < t2 < t3):
+        return [tuple(p1[k] + (p2[k] - p1[k]) * (i / n) for k in range(3))
+                for i in range(1, n + 1)]
+
+    out = []
+    for i in range(1, n + 1):
+        t = t1 + (t2 - t1) * (i / n)
+        a1 = [(t1 - t) / (t1 - t0) * p0[k] + (t - t0) / (t1 - t0) * p1[k] for k in range(3)]
+        a2 = [(t2 - t) / (t2 - t1) * p1[k] + (t - t1) / (t2 - t1) * p2[k] for k in range(3)]
+        a3 = [(t3 - t) / (t3 - t2) * p2[k] + (t - t2) / (t3 - t2) * p3[k] for k in range(3)]
+        b1 = [(t2 - t) / (t2 - t0) * a1[k] + (t - t0) / (t2 - t0) * a2[k] for k in range(3)]
+        b2 = [(t3 - t) / (t3 - t1) * a2[k] + (t - t1) / (t3 - t1) * a3[k] for k in range(3)]
+        out.append(tuple((t2 - t) / (t2 - t1) * b1[k] + (t - t1) / (t2 - t1) * b2[k]
+                         for k in range(3)))
+    return out
+
+
+def spline_dense_path(points, spacing: float):
+    """Centripetal Catmull-Rom through ``points``, ~``spacing`` apart."""
+    if len(points) == 1:
+        return list(points)
+    if len(points) == 2:
+        # Not enough control points for a spline — straight segment.
+        (ax, ay, az), (bx, by, bz) = points
+        steps = max(1, math.ceil(math.dist(points[0], points[1]) / spacing))
+        return [points[0]] + [
+            (ax + (bx - ax) * i / steps,
+             ay + (by - ay) * i / steps,
+             az + (bz - az) * i / steps) for i in range(1, steps + 1)]
+
+    # Pad ends with reflected phantom points so every segment has 4
+    # distinct control points (duplicated endpoints would collapse the
+    # centripetal knot spacing and degrade the spline to straight lines).
+    first = tuple(2 * a - b for a, b in zip(points[0], points[1]))
+    last = tuple(2 * a - b for a, b in zip(points[-1], points[-2]))
+    padded = [first] + list(points) + [last]
+    dense = [points[0]]
+    for i in range(len(padded) - 3):
+        p0, p1, p2, p3 = padded[i:i + 4]
+        n = max(1, math.ceil(math.dist(p1, p2) / spacing))
+        dense.extend(_catmull_rom_segment(p0, p1, p2, p3, n))
+    return dense
+
+
+class RoutePlannerBeta(Node):
+    def __init__(self):
+        super().__init__(NODE_NAME)
+        self.declare_parameter("route", "")
+        self.declare_parameter("relative", True)
+        self.declare_parameter("spacing_m", 1.0)
+        self.declare_parameter("arrival_radius_m", 2.0)
+        self.declare_parameter("replan_rate_hz", 2.0)
+
+        route_spec = self.get_parameter("route").value
+        if not route_spec:
+            raise SystemExit(f"{NODE_NAME}: required parameter 'route' is empty")
+        self._route_body = parse_route(route_spec)
+        self._route_world = None
+        self._next_idx = 0
+        self._last_odom = None
+
+        self._path_pub = self.create_publisher(Path, "~/planned_path", 10)
+        self._odom_sub = self.create_subscription(
+            Odometry, "~/odom_in", self._on_odom, 10)
+        rate = float(self.get_parameter("replan_rate_hz").value)
+        self._timer = self.create_timer(1.0 / max(rate, 0.1), self._replan)
+        self.get_logger().info(
+            f"{NODE_NAME} up with {len(self._route_body)} waypoints; "
+            f"waiting for odometry on ~/odom_in")
+
+    def _on_odom(self, msg: Odometry):
+        self._last_odom = msg
+        if self._route_world is None:
+            p = msg.pose.pose.position
+            q = msg.pose.pose.orientation
+            if self.get_parameter("relative").value:
+                yaw = yaw_from_quaternion(q.x, q.y, q.z, q.w)
+                self._route_world = anchor_route(
+                    self._route_body, p.x, p.y, p.z, yaw)
+            else:
+                self._route_world = list(self._route_body)
+            self.get_logger().info(
+                "route anchored: "
+                + "; ".join(f"({x:.1f}, {y:.1f}, {z:.1f})"
+                            for x, y, z in self._route_world))
+
+    def _replan(self):
+        if self._last_odom is None or self._route_world is None:
+            return
+        p = self._last_odom.pose.pose.position
+        pos = (p.x, p.y, p.z)
+
+        radius = float(self.get_parameter("arrival_radius_m").value)
+        while (self._next_idx < len(self._route_world)
+               and math.dist(pos, self._route_world[self._next_idx]) < radius):
+            self.get_logger().info(f"waypoint {self._next_idx} reached")
+            self._next_idx += 1
+
+        remaining = self._route_world[self._next_idx:]
+        if remaining:
+            spacing = float(self.get_parameter("spacing_m").value)
+            points = spline_dense_path([pos] + remaining, spacing)
+        else:
+            points = [self._route_world[-1]]
+
+        self._publish_path(points)
+
+    def _publish_path(self, points):
+        msg = Path()
+        msg.header.stamp = self.get_clock().now().to_msg()
+        msg.header.frame_id = self._last_odom.header.frame_id
+        for x, y, z in points:
+            pose = PoseStamped()
+            pose.header = msg.header
+            pose.pose.position.x = float(x)
+            pose.pose.position.y = float(y)
+            pose.pose.position.z = float(z)
+            pose.pose.orientation.w = 1.0
+            msg.poses.append(pose)
+        self._path_pub.publish(msg)
+
+
+def main():
+    rclpy.init()
+    node = RoutePlannerBeta()
+    try:
+        rclpy.spin(node)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        node.destroy_node()
+        rclpy.try_shutdown()
+
+
+if __name__ == "__main__":
+    main()
