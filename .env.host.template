# Host-side env for `uv run --env-file .env.host …` (or export UV_ENV_FILE).
# Distinct from `.env`, which is docker-compose variable interpolation only.

# Kit refuses to bootstrap non-interactively without this and prompts on stdin,
# which fails as "Unable to bootstrap inner kit kernel: EOF when reading a line".
# Mirrors ACCEPT_EULA=Y in simulation/isaac-sim/docker/omni_pass.env, i.e. the
# acceptance this project already made for the container.
OMNI_KIT_ACCEPT_EULA=YES
OMNI_ENV_PRIVACY_CONSENT=Y
