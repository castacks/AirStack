#usda 1.0
#
# USD wrapper for the AEC pack's Mulch_Brown MDL -- bark mulch, for planting
# beds.
#
# See Grass_Cut.usda for why the wrapper is needed and how the relative paths
# are anchored. Note this MDL's textures are named `_baseColor` / `_N` rather
# than the `_BaseColor` / `_Normal` the two grasses use -- irrelevant to USD
# (the MDL names them itself), but it will bite anyone who checks by pattern.
(
    defaultPrim = "Mulch_Brown"
    upAxis = "Z"
)

def Material "Mulch_Brown"
{
    token outputs:mdl:displacement.connect = </Mulch_Brown/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Mulch_Brown/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Mulch_Brown/Shader.outputs:out>
    token outputs:surface.connect = </Mulch_Brown/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @../aec/brownstone/Materials/Base/Natural/Mulch_Brown.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "Mulch_Brown"
        token outputs:out
    }
}
