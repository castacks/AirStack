#usda 1.0
#
# USD wrapper for the AEC pack's Grass_Countryside MDL -- rough meadow grass,
# the counterpart to the mown Grass_Cut. Used for undeveloped land and for the
# park, so the park ground reads as a different surface from the front lawns.
#
# See Grass_Cut.usda for why the wrapper is needed and how the relative paths
# are anchored.
(
    defaultPrim = "Grass_Countryside"
    upAxis = "Z"
)

def Material "Grass_Countryside"
{
    token outputs:mdl:displacement.connect = </Grass_Countryside/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Grass_Countryside/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Grass_Countryside/Shader.outputs:out>
    token outputs:surface.connect = </Grass_Countryside/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @../aec/brownstone/Materials/Base/Natural/Grass_Countryside.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "Grass_Countryside"
        token outputs:out
    }
}
