#usda 1.0
#
# USD wrapper for the AEC pack's Dirt MDL -- bare earth, for playground fall
# zones and worn ground.
#
# See Grass_Cut.usda for why the wrapper is needed and how the relative paths
# are anchored.
(
    defaultPrim = "Dirt"
    upAxis = "Z"
)

def Material "Dirt"
{
    token outputs:mdl:displacement.connect = </Dirt/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Dirt/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Dirt/Shader.outputs:out>
    token outputs:surface.connect = </Dirt/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @../aec/brownstone/Materials/Base/Natural/Dirt.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "Dirt"
        token outputs:out
    }
}
