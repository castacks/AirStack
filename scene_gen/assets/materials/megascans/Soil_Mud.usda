#usda 1.0
(
    defaultPrim = "Soil_Mud"
)

# Generated by tools/import_megascans.py from soil_mud_pjuph20_1k_ue_low.zip
# Textures are Megascans maps; ORM is packed R=occlusion G=roughness B=metallic,
# which OmniPBR unpacks itself when `enable_ORM_texture` is on.

def Material "Soil_Mud"
{
    token outputs:mdl:displacement.connect = </Soil_Mud/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Soil_Mud/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Soil_Mud/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
        asset inputs:diffuse_texture = @./Soil_Mud/T_pjuph20_1K_B.jpg@
        asset inputs:normalmap_texture = @./Soil_Mud/T_pjuph20_1K_N.jpg@
        bool inputs:enable_ORM_texture = 1
        asset inputs:ORM_texture = @./Soil_Mud/T_pjuph20_1K_ORM.jpg@
        float2 inputs:texture_scale = (0.11, 0.11)
        bool inputs:project_uvw = 1
        bool inputs:world_or_object = 1
        token outputs:out (renderType = "material")
    }
}
