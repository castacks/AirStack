#usda 1.0
(
    defaultPrim = "Brick_Wall_Worn"
)

# Generated by tools/import_megascans.py from (extracted textures)
# Textures are Megascans maps; ORM is packed R=occlusion G=roughness B=metallic,
# which OmniPBR unpacks itself when `enable_ORM_texture` is on.

def Material "Brick_Wall_Worn"
{
    token outputs:mdl:displacement.connect = </Brick_Wall_Worn/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Brick_Wall_Worn/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Brick_Wall_Worn/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
        asset inputs:diffuse_texture = @./Brick_Wall_Worn/T_sexkaitb_1K_B.jpg@
        asset inputs:normalmap_texture = @./Brick_Wall_Worn/T_sexkaitb_1K_N.jpg@
        bool inputs:enable_ORM_texture = 1
        asset inputs:ORM_texture = @./Brick_Wall_Worn/T_sexkaitb_1K_ORM.jpg@
        float2 inputs:texture_scale = (0.35, 0.35)
        bool inputs:project_uvw = 1
        bool inputs:world_or_object = 1
        token outputs:out (renderType = "material")
    }
}
