#usda 1.0
(
    defaultPrim = "Road_Line_Yellow"
)

# Generated by tools/import_megascans.py from yellow_road_line_vixpceh_1k_ue_low.zip
# Textures are Megascans maps; ORM is packed R=occlusion G=roughness B=metallic,
# which OmniPBR unpacks itself when `enable_ORM_texture` is on.

def Material "Road_Line_Yellow"
{
    token outputs:mdl:displacement.connect = </Road_Line_Yellow/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Road_Line_Yellow/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Road_Line_Yellow/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
        asset inputs:diffuse_texture = @./Road_Line_Yellow/T_vixpceh_1K_B-O.png@
        asset inputs:normalmap_texture = @./Road_Line_Yellow/T_vixpceh_1K_N.jpg@
        bool inputs:enable_ORM_texture = 1
        asset inputs:ORM_texture = @./Road_Line_Yellow/T_vixpceh_1K_ORM.jpg@
        float2 inputs:texture_scale = (0.35, 0.35)
        bool inputs:project_uvw = 1
        bool inputs:world_or_object = 1
        token outputs:out (renderType = "material")
    }
}
