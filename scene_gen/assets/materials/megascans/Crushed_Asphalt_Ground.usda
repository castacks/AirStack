#usda 1.0
(
    defaultPrim = "Crushed_Asphalt_Ground"
)

# Generated by tools/import_megascans.py from crushed_asphalt_ground_sjyjcbja_8k_ue_raw.zip
# Textures are Megascans maps; ORM is packed R=occlusion G=roughness B=metallic,
# which OmniPBR unpacks itself when `enable_ORM_texture` is on.

def Material "Crushed_Asphalt_Ground"
{
    token outputs:mdl:displacement.connect = </Crushed_Asphalt_Ground/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Crushed_Asphalt_Ground/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Crushed_Asphalt_Ground/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
        asset inputs:diffuse_texture = @./Crushed_Asphalt_Ground/T_sjyjcbja_8K_B.png@
        asset inputs:normalmap_texture = @./Crushed_Asphalt_Ground/T_sjyjcbja_8K_N.png@
        bool inputs:enable_ORM_texture = 1
        asset inputs:ORM_texture = @./Crushed_Asphalt_Ground/T_sjyjcbja_8K_ORM.png@
        float2 inputs:texture_scale = (0.11, 0.11)
        bool inputs:project_uvw = 1
        bool inputs:world_or_object = 1
        token outputs:out (renderType = "material")
    }
}
