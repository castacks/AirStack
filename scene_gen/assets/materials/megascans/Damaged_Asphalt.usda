#usda 1.0
(
    defaultPrim = "Damaged_Asphalt"
)

# Generated by tools/import_megascans.py from damaged_asphalt_vizcebf_2k_ue_mid.zip
# Textures are Megascans maps; ORM is packed R=occlusion G=roughness B=metallic,
# which OmniPBR unpacks itself when `enable_ORM_texture` is on.

def Material "Damaged_Asphalt"
{
    token outputs:mdl:displacement.connect = </Damaged_Asphalt/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Damaged_Asphalt/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Damaged_Asphalt/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
        asset inputs:diffuse_texture = @./Damaged_Asphalt/T_vizcebf_2K_B.png@
        asset inputs:normalmap_texture = @./Damaged_Asphalt/T_vizcebf_2K_N.png@
        bool inputs:enable_ORM_texture = 1
        asset inputs:ORM_texture = @./Damaged_Asphalt/T_vizcebf_2K_ORM.png@
        float2 inputs:texture_scale = (0.11, 0.11)
        bool inputs:project_uvw = 1
        bool inputs:world_or_object = 1
        token outputs:out (renderType = "material")
    }
}
