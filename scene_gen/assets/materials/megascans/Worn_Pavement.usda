#usda 1.0
(
    defaultPrim = "Worn_Pavement"
)

# Generated by tools/import_megascans.py from worn_pavement_uddhdb1fw_2k_ue_mid.zip
# Textures are Megascans maps; ORM is packed R=occlusion G=roughness B=metallic,
# which OmniPBR unpacks itself when `enable_ORM_texture` is on.

def Material "Worn_Pavement"
{
    token outputs:mdl:displacement.connect = </Worn_Pavement/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Worn_Pavement/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Worn_Pavement/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
        asset inputs:diffuse_texture = @./Worn_Pavement/T_uddhdb1fw_2K_B.png@
        asset inputs:normalmap_texture = @./Worn_Pavement/T_uddhdb1fw_2K_N.png@
        bool inputs:enable_ORM_texture = 1
        asset inputs:ORM_texture = @./Worn_Pavement/T_uddhdb1fw_2K_ORM.png@
        float2 inputs:texture_scale = (0.35, 0.35)
        bool inputs:project_uvw = 1
        bool inputs:world_or_object = 1
        token outputs:out (renderType = "material")
    }
}
