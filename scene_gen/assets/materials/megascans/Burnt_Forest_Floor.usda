#usda 1.0
(
    defaultPrim = "Burnt_Forest_Floor"
)

# Generated by tools/import_megascans.py from burnt_forest_floor_uhwpehcdy_4k_ue_high.zip
# Textures are Megascans maps; ORM is packed R=occlusion G=roughness B=metallic,
# which OmniPBR unpacks itself when `enable_ORM_texture` is on.

def Material "Burnt_Forest_Floor"
{
    token outputs:mdl:displacement.connect = </Burnt_Forest_Floor/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Burnt_Forest_Floor/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Burnt_Forest_Floor/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
        asset inputs:diffuse_texture = @./Burnt_Forest_Floor/T_uhwpehcdy_4K_B.png@
        asset inputs:normalmap_texture = @./Burnt_Forest_Floor/T_uhwpehcdy_4K_N.png@
        bool inputs:enable_ORM_texture = 1
        asset inputs:ORM_texture = @./Burnt_Forest_Floor/T_uhwpehcdy_4K_ORM.png@
        float2 inputs:texture_scale = (0.11, 0.11)
        bool inputs:project_uvw = 1
        bool inputs:world_or_object = 1
        token outputs:out (renderType = "material")
    }
}
