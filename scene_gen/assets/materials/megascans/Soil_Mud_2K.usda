#usda 1.0
(
    defaultPrim = "Soil_Mud_2K"
)

# The SAME Megascans surface as Soil_Mud.usda (pjuph20) at 2K instead of 1K.
# Kept as a separate material rather than swapped in place because the 1K maps
# are what every existing scene's ground overlay is tuned against, and a
# resolution change alters how a `texture_scale` reads.
#
# Use this one for anything seen CLOSE — displaced mud, wrack windrows, the
# scoured yard around a house — where the 1K maps visibly tile. ORM is packed
# R=occlusion G=roughness B=metallic; OmniPBR unpacks it when
# `enable_ORM_texture` is on.

def Material "Soil_Mud_2K"
{
    token outputs:mdl:displacement.connect = </Soil_Mud_2K/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Soil_Mud_2K/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Soil_Mud_2K/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
        asset inputs:diffuse_texture = @./Soil_Mud/T_pjuph20_2K_B.png@
        asset inputs:normalmap_texture = @./Soil_Mud/T_pjuph20_2K_N.png@
        bool inputs:enable_ORM_texture = 1
        asset inputs:ORM_texture = @./Soil_Mud/T_pjuph20_2K_ORM.png@
        float2 inputs:texture_scale = (0.11, 0.11)
        bool inputs:project_uvw = 1
        bool inputs:world_or_object = 1
        token outputs:out (renderType = "material")
    }
}
