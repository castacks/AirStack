#usda 1.0
(
    defaultPrim = "Dirt_Rough"
)

# Generated by tools/import_megascans.py from military_trenches_ground_dirt_rough_01_yd0lfcqcc_1k_ue_low.zip
# Textures are Megascans maps; ORM is packed R=occlusion G=roughness B=metallic,
# which OmniPBR unpacks itself when `enable_ORM_texture` is on.

def Material "Dirt_Rough"
{
    token outputs:mdl:displacement.connect = </Dirt_Rough/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Dirt_Rough/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Dirt_Rough/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
        uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
        asset inputs:diffuse_texture = @./Dirt_Rough/T_yd0lfcqcc_1k_B.png@
        asset inputs:normalmap_texture = @./Dirt_Rough/T_yd0lfcqcc_1k_N.png@
        bool inputs:enable_ORM_texture = 1
        asset inputs:ORM_texture = @./Dirt_Rough/T_yd0lfcqcc_1k_ORM.png@
        float2 inputs:texture_scale = (0.11, 0.11)
        bool inputs:project_uvw = 1
        bool inputs:world_or_object = 1
        token outputs:out (renderType = "material")
    }
}
