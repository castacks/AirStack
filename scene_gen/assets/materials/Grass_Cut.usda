#usda 1.0
#
# USD wrapper for the AEC pack's Grass_Cut MDL -- a mown lawn.
#
# WHY THIS FILE EXISTS: the AEC pack ships ground materials as bare `.mdl`
# modules with no USD alongside them, but the pipeline needs a `.usd`.
# `suburb_scene.apply_ground._load_mat` does
#     prim.GetReferences().AddReference(url); UsdShade.Material(prim)
# so every entry under `usds.materials` must be a USD layer whose DEFAULT PRIM
# is a UsdShade.Material. An `.mdl` referenced directly is not that and binds
# nothing. This layer is that Material, and the MDL is reached through a
# sourceAsset shader.
#
# The `.mdl` path is RELATIVE and is anchored to THIS layer, not to the stage
# that references it, so the wrapper stays valid wherever the scene is built.
# The MDL's own textures (./Grass_Cut/Grass_Cut_{BaseColor,Normal,ORM}.png) are
# resolved by the MDL compiler at render time, not by USD -- they will never
# show up in a UsdAssetPath resolve, so verify them by file existence instead.
(
    defaultPrim = "Grass_Cut"
    upAxis = "Z"
)

def Material "Grass_Cut"
{
    token outputs:mdl:displacement.connect = </Grass_Cut/Shader.outputs:out>
    token outputs:mdl:surface.connect = </Grass_Cut/Shader.outputs:out>
    token outputs:mdl:volume.connect = </Grass_Cut/Shader.outputs:out>
    token outputs:surface.connect = </Grass_Cut/Shader.outputs:out>

    def Shader "Shader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:mdl:sourceAsset = @../aec/brownstone/Materials/Base/Natural/Grass_Cut.mdl@
        # Must match the name the MDL actually exports (`export material
        # Grass_Cut(*)` in Grass_Cut.mdl), not the file name -- they agree here
        # but that is a property of this pack, not a rule.
        uniform token info:mdl:sourceAsset:subIdentifier = "Grass_Cut"
        token outputs:out
    }
}
