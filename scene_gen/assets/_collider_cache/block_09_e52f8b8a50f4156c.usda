#usda 1.0
(
    defaultPrim = "Asset"
)

def "Asset" (
    prepend references = @omniverse://airlab-nucleus.andrew.cmu.edu:443/Projects/SEI-COA/scene_gen/assets/standalone/buildings/intact/midrise/block_09/block_09.usdc@
)
{
    over "buildings"
    {
        over "Meshes"
        {
            over "Sketchfab_model"
            {
                over "Buildings_fbx"
                {
                    over "RootNode"
                    {
                        over "Building_09_xform"
                        {
                            over "Building_09"
                            {
                                over "Building_09_brick_modern_0" (
                                    prepend apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

