        over "Model"
        {
            over "G_4_1"
            {
                over "Group1"
                {
                    over "G_3445_1"
                    {
                        over "office_tower"
                        {
                            over "Mesh1" (
                                prepend apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }
        }
    }
}

