#usda 1.0
(
    defaultPrim = "Asset"
)

def "Asset" (
    prepend references = @omniverse://airlab-nucleus.andrew.cmu.edu:443/Projects/SEI-COA/scene_gen/assets/standalone/buildings/destroyed/midrise/abandoned_brick_building/abandoned_brick_building.usdc@
)
{
    over "simple_low_poly_abandoned_brick_building"
    {
        over "Meshes"
        {
            over "Sketchfab_model"
            {
                over "Collada_visual_scene_group"
                {
                    over "abandoned_brick_building"
                    {
                        over "Material2" (
                            prepend apiSchemas = ["PhysicsCollisionAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }
}

