#usda 1.0
(
    defaultPrim = "Asset"
)

def "Asset" (
    prepend references = @omniverse://airlab-nucleus.andrew.cmu.edu:443/Projects/SEI-COA/scene_gen/assets/standalone/buildings/intact/tower/stepped_tower/stepped_tower.usdc@
)
{
    over "large_low_poly_building"
    {
        over "Meshes"
        {
            over "Sketchfab_model"
            {
                over "Collada_visual_scene_group"
                {
                    over "stepped_tower"
                    {
                        over "Material2" (
                            prepend apiSchemas = ["PhysicsCollisionAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }
}

