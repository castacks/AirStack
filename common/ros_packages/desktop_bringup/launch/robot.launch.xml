<!-- Desktop / sim wrapper around autonomy_bringup robot.launch.xml: forwards
     sim/urdf_file and optionally adds RViz. Stack dispatch args
     (AIRSTACK_STACK_DIR / AIRSTACK_STACK_ENTRY) flow through env-var
     defaults inside autonomy_bringup, so both wrappers behave identically
     (no stack env set = stacks/full_default; the legacy AUTONOMY_ROLE
     dispatch was removed — stacks are the only dispatch).
     Launched by: the robot container (LAUNCH_PACKAGE=desktop_bringup).
     STATUS: standalone utility (container entry wrapper). -->
<launch>
  <arg name="sim" default="true"
       description="Use simulation time and sim defaults" />
  <arg name="urdf_file" default="$(env URDF_FILE iris_with_sensors.pegasus.robot.urdf)"
       description="Robot description URDF filename (robot_descriptions package)" />
  <arg name="debug_rviz" default="$(env DEBUG_RVIZ false)"
       description="Also start RViz with the desktop_bringup robot config" />

  <!-- Core robot launch (state publisher, static TFs, autonomy modules) -->
  <include file="$(find-pkg-share autonomy_bringup)/launch/robot.launch.xml">
    <arg name="sim" value="$(var sim)" />
    <arg name="urdf_file" value="$(var urdf_file)" />
  </include>

  <group if="$(var debug_rviz)">
    <node pkg="rviz2" exec="rviz2"
      args="-d $(find-pkg-share desktop_bringup)/rviz/robot.rviz --ros-args --log-level INFO"
      output="screen" respawn="true" respawn_delay="1" />
  </group>


</launch>