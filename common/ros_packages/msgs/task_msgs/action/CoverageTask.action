# Perform a systematic coverage survey of a polygonal area.
# heading_deg / orientation_deg: degrees about +Z (REP-103 yaw), CCW from +X ("east").
# orientation_mode selects how waypoint yaw is set along the planned path.

# Goal
geometry_msgs/Polygon coverage_area
float32 min_altitude_agl
float32 max_altitude_agl
float32 min_flight_speed
float32 max_flight_speed
float32 line_spacing_m
float32 heading_deg
uint8 COVERAGE_ORIENTATION_FACE_PATH=0
uint8 COVERAGE_ORIENTATION_ALIGNED_TO_SWEEP=1
uint8 COVERAGE_ORIENTATION_FIXED=2
uint8 orientation_mode
float32 orientation_deg
---
# Result
bool success
string message
float32 coverage_percentage
---
# Feedback
string status
float32 progress
float32 coverage_percentage
geometry_msgs/Point current_position
