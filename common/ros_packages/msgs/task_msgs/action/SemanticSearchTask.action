# Search an area for a location or object described in natural language.
# query: natural-language description of the target (e.g. "red car", "person waving")
# confidence_threshold: minimum match confidence to report a result (0.0-1.0, default 0.95)
# background_queries: comma-separated contrast classes for softmax normalization
#   (e.g. "building,tree,ground"). Required — softmax over a single query is degenerate.

# Goal
string query
string background_queries
geometry_msgs/Polygon search_area
float32 min_altitude_agl 3.0
float32 max_altitude_agl 15.0
float32 min_flight_speed
float32 max_flight_speed
float32 confidence_threshold 0.95
# Optional raven_nav tuning overrides. A sentinel (<0, or <1 for the count) means
# "unset" -> raven_nav.yaml default is used. Settable per-scene in the mission file.
float32 score_threshold -1.0
float32 voxel_score_threshold -1.0
float32 voxel_min_confidence -1.0
int32 voxel_min_cluster_size -1
# Optional cap on accumulated instances. 0 = unlimited; task completes only on
# coverage criterion or operator cancel.
int32 max_instances 0
# Debug/manual-fly mode: bring up rayfronts + raven and publish all their
# visualization (grouped rays, frontiers, bounding boxes, discoveries) but do
# NOT command the drone — the operator flies it manually (e.g. via the
# navigate / fixed-trajectory task from GCS) to inspect what rayfronts detects.
# Also settable per-node via the SEMANTIC_SEARCH_DEBUG env var.
bool debug false
---
# Result
bool success
string message
geometry_msgs/PoseArray found_poses
string[] found_labels        # parallel to found_poses
float32 confidence            # max confidence across found instances
int32 objects_found
---
# Feedback
string status
float32 progress
float32 best_confidence_so_far
int32 objects_found_so_far
geometry_msgs/Point current_position
# Live running list of discoveries — refreshed each feedback tick so GCS
# can render markers as they accumulate.
geometry_msgs/PoseArray current_found_poses
string[] current_found_labels
