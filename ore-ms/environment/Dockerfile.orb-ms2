# Build context: ore-ms/environment. No private datasets or credentials enter it.
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git ca-certificates libopencv-dev libeigen3-dev \
    libboost-serialization-dev libssl-dev libglew-dev libgl1-mesa-dev \
    libpython3-dev python3-numpy python3-opencv python3-pytest \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/stevenlovegrove/Pangolin.git /opt/Pangolin \
    && git -C /opt/Pangolin checkout --detach dd801d244db3a8e27b7fe8020cd751404aa818fd \
    && cmake -S /opt/Pangolin -B /opt/Pangolin/build \
       -DCMAKE_BUILD_TYPE=Release -DBUILD_PANGOLIN_PYTHON=OFF \
       -DBUILD_EXAMPLES=OFF -DBUILD_TOOLS=OFF '-DCMAKE_CXX_FLAGS=-include cstdint' \
    && cmake --build /opt/Pangolin/build -j4 \
    && cmake --install /opt/Pangolin/build && ldconfig
RUN git clone https://github.com/UZ-SLAMLab/ORB_SLAM3.git /opt/ORB_SLAM3 \
    && git -C /opt/ORB_SLAM3 checkout --detach 4452a3c4ab75b1cde34e5505a36ec3f9edcdc4c4 \
    && cmake -S /opt/ORB_SLAM3/Thirdparty/DBoW2 -B /opt/ORB_SLAM3/Thirdparty/DBoW2/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /opt/ORB_SLAM3/Thirdparty/DBoW2/build -j4 \
    && cmake -S /opt/ORB_SLAM3/Thirdparty/g2o -B /opt/ORB_SLAM3/Thirdparty/g2o/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_STANDARD=11 \
    && cmake --build /opt/ORB_SLAM3/Thirdparty/g2o/build -j8 \
    && tar -xzf /opt/ORB_SLAM3/Vocabulary/ORBvoc.txt.tar.gz -C /opt/ORB_SLAM3/Vocabulary
RUN cmake -S /opt/ORB_SLAM3 -B /opt/ORB_SLAM3/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /opt/ORB_SLAM3/build --target ORB_SLAM3 -j8
COPY orb_rectified_logging.patch /opt/ore-ms-adapter/orb_rectified_logging.patch
# The pinned settings printer dereferences an uninitialized second-camera
# pointer in Rectified mode. Guard only that diagnostic block, not the estimator.
RUN git -C /opt/ORB_SLAM3 apply /opt/ore-ms-adapter/orb_rectified_logging.patch \
    && cmake --build /opt/ORB_SLAM3/build --target ORB_SLAM3 -j8
COPY orb_ms2_runner.cc /opt/ore-ms-adapter/orb_ms2_runner.cc
COPY orb_ms2_CMakeLists.txt /opt/ore-ms-adapter/CMakeLists.txt
RUN cmake -S /opt/ore-ms-adapter -B /opt/ore-ms-adapter/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /opt/ore-ms-adapter/build -j2 \
    && dpkg-query -W > /opt/ore-ms-adapter/packages.txt
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /workspace
