# Build context is generated by build_context.py; never use the whole workspace.
# Pin both base images by digest before a reproducible build.
ARG ISAAC_IMAGE=airlab-docker.andrew.cmu.edu/airstack/airstack@sha256:2f3d4ae58c5e8d9c4e82c55ab9278573661f45ad74f56cff765fc7f6fa71fc09
ARG ROBOT_IMAGE=airlab-docker.andrew.cmu.edu/airstack/airstack@sha256:52b26f9dfe27cd895c3090cf8036c64ac20577b21c7b1865ee5e1ba5a3996395
FROM ${ISAAC_IMAGE} AS simulator
FROM ${ROBOT_IMAGE} AS flight
USER root
ENV ISAACSIM_PATH=/isaac-sim
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]
COPY --from=simulator /isaac-sim /isaac-sim
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake libcgal-dev libopenvdb-dev libtbb-dev libzstd-dev \
    python3-venv python3-colcon-common-extensions python3-rosdep python3-pil \
    python3-yaml python3-scipy ffmpeg fonts-dejavu-core curl ca-certificates bzip2 \
    ros-jazzy-rosbag2-storage-mcap \
    && rm -rf /var/lib/apt/lists/*
# Cache ROS compilation independently of bench/controller Python changes.
COPY workspace/AirStack/common/ /opt/ws2/AirStack/common/
COPY workspace/AirStack/robot/ /opt/ws2/AirStack/robot/
COPY workspace/AirStack/simulation/isaac-sim/extensions/ /opt/ws2/AirStack/simulation/isaac-sim/extensions/
# Reproduce the common ROS source mount without requiring the submitting laptop.
RUN test ! -e /opt/ws2/AirStack/robot/ros_ws/src/common && \
    ln -s ../../../common/ros_packages /opt/ws2/AirStack/robot/ros_ws/src/common && \
    rm -rf /root/AirStack /isaac-sim/AirStack && \
    ln -s /opt/ws2/AirStack /isaac-sim/AirStack && \
    ln -s /opt/ws2/AirStack /root/AirStack
RUN extension=/isaac-sim/.local/share/ov/data/documents/Kit/shared/exts/pegasus.simulator && \
    rm -rf "$extension" && \
    cp -a /opt/ws2/AirStack/simulation/isaac-sim/extensions/PegasusSimulator/extensions/pegasus.simulator "$extension" && \
    /isaac-sim/python.sh -m pip install --no-deps -e "$extension"
WORKDIR /opt/ws2/AirStack/robot/ros_ws
RUN source /opt/ros/jazzy/setup.bash && \
    colcon build --parallel-workers 4 --cmake-args -DCMAKE_BUILD_TYPE=Release && \
    source install/setup.bash && \
    ros2 pkg prefix desktop_bringup && ros2 pkg prefix mononav_bridge && \
    ros2 pkg prefix trajectory_controller && ros2 pkg prefix pid_controller
# Separate Python 3.10 environment for the original workers; ROS remains 3.12.
# Pin micromamba and verify its archive before executing it.
ARG MICROMAMBA_SHA256=ff1a10b46e9ee673bb672ac464d4787b4e9c3569b75816a56f76dddc0b1f07fc
RUN test -n "$MICROMAMBA_SHA256" && \
    curl -fLsS https://conda.anaconda.org/conda-forge/linux-64/micromamba-2.0.5-1.tar.bz2 -o /tmp/micromamba.tar.bz2 && \
    echo "$MICROMAMBA_SHA256  /tmp/micromamba.tar.bz2" | sha256sum -c - && \
    tar -xjf /tmp/micromamba.tar.bz2 -C /tmp bin/micromamba && \
    /tmp/bin/micromamba create -y -p /opt/ws2/model -c conda-forge python=3.10 pip && \
    rm -rf /tmp/bin /tmp/micromamba.tar.bz2 /root/.local/share/mamba/pkgs
ARG PLANNER
COPY requirements/ /tmp/requirements/
RUN /opt/ws2/model/bin/pip install --no-cache-dir -r "/tmp/requirements/${PLANNER}.txt" && \
    /opt/ws2/model/bin/pip freeze > /opt/ws2/AirStack/model_packages.txt && \
    rm -rf /tmp/requirements
# PX4 in the simulator base links these libraries, absent from the robot base.
COPY --from=simulator /usr/lib/x86_64-linux-gnu/libgz-transport13.so* /usr/local/lib/
COPY --from=simulator /usr/lib/x86_64-linux-gnu/libgz-msgs10.so* /usr/local/lib/
COPY --from=simulator /usr/lib/x86_64-linux-gnu/libgz-utils2.so* /usr/local/lib/
RUN ldconfig && \
    ldd /isaac-sim/PX4-Autopilot/build/px4_sitl_default/bin/px4 > /tmp/px4-libraries.txt && \
    ! grep -q 'not found' /tmp/px4-libraries.txt
COPY workspace/ /opt/ws2/
ENV WS2_REMOTE_TASK=1 WS2_EXECUTION_BACKEND=process WS2_HEADLESS=1 \
    WS2_GT_HOST=127.0.0.1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    ROBOT_NAME=robot_1 ROS_DOMAIN_ID=1 ROS_DISTRO=jazzy \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    ISAACSIM_PATH=/isaac-sim ACCEPT_EULA=Y OMNI_KIT_ALLOW_ROOT=1 PRIVACY_CONSENT=Y \
    TORCH_HOME=/opt/ws2/torch NVIDIA_DRIVER_CAPABILITIES=all \
    OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
WORKDIR /opt/ws2/AirStack
EXPOSE 8894
ENTRYPOINT []
CMD ["/usr/bin/python3", "tools/ws2_bench/osmo_task.py", "--help"]
