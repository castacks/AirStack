# Test results
tests/results/

# Local-only — embedded sibling repo, not part of this branch
common/rayfronts/

# Docker build cache (root-owned subdirs cause permission warnings on `git add`)
robot/docker/cache/
.DS_Store
gcs/.DS_Store

# Objaverse assets: converted USDs + textures are large and reproducible.
# manifest.yaml is committed; `scene_gen/prepare_assets.py` rebuilds it from the asset sets.
scene_gen/assets/objaverse/*
!scene_gen/assets/objaverse/manifest.yaml

# NVIDIA AEC demo packs (Brownstone / City Tower): vendor content, gigabytes,
# re-extractable from the downloaded zips. See scene_gen/assets/aec/README.md.
scene_gen/assets/aec/*
!scene_gen/assets/aec/README.md

# DowntownCity buildings: converted out of the SEI-COA Nucleus pack's joined
# FBX/glTF exports. 231 MB, and reproducible by the two commands in the README.
scene_gen/assets/downtowncity/*
!scene_gen/assets/downtowncity/README.md

# Composited soot/burn maps written by scene_gen/disaster/scorch.py. Keyed by a
# hash of the source texture and the recipe, so they are a cache, not source:
# whatever a scene needs is rebuilt on first run. ~200 MB once a wildfire scene
# has been generated.
scene_gen/assets/materials/scorched/

# Baked per-object USDs written by `disaster/bake.py` — fracture and settle run
# once per archetype and the result is referenced, so these are derived from the
# scene config and rebuilt by the bake launchers. Gigabytes if left in.
scene_gen/assets/baked/
scene_gen/assets/archetypes/

# Staging directory for hand-uploading assets to Nucleus.
nucleus_upload/

# Local mirror of Nucleus assets, for the tools that cannot resolve
# `omniverse://` — the damage gallery above all (usd-core and Blender both
# lack the resolver). Rebuild with scene_gen/tools/localize_nucleus_assets.py,
# which must run inside the isaac-sim container.
scene_gen/assets/nucleus/

# omni.client extracted from the isaac-sim image by scene_gen/tools/nucleus.py,
# which reads Nucleus from the HOST (no Kit boot). NVIDIA binaries, ~44 MB,
# already on the machine inside the image — re-extract with `nucleus.py --setup`.
scene_gen/assets/omniclient/

# Search index for scene_gen/tools/nucleus_materials.py — a cached crawl of the
# Nucleus material roots, rebuilt in ~15 s with `nucleus_materials.py --reindex`.
# Persistent asset footprint measurements (scene_gen/measure_cache.py). Derived,
# machine-specific, and keyed on each asset's mtime/size so it self-invalidates.
scene_gen/assets/.measurements.json

# Offline scene cache (scene_gen/scene_cache.py) — layout, pristine and
# disaster scenes keyed by the high-level config.
scene_gen/assets/scenes/

scene_gen/assets/nucleus_material_index.json

# Host-side env file for `uv run --env-file` (EULA/consent acceptance).
# Per-user, like omni_pass.env. Template: .env.host.template
.env.host

# Layout plan PNGs and the asset manifest — generated, not source.
scene_gen/_plans/
scene_gen/_scene_assets.tsv

# damage_lab.ipynb scratch USDs — regenerated by any cell run.
scene_gen/_damage_lab/
scene_gen/_bench/

# Damage-gallery renders and the USDs behind them (scene_gen/tools/damage_gallery.py).
# Regenerate rather than commit: a sheet runs to tens of MB and is fully
# reproducible from (asset set, seed, severity).
scene_gen/galleries/

# standalone asset pack (converted from ~/coasei/new_assets, 2026-08-26): 400 MB of
# USD + textures, rebuilt by the commands in its README.
scene_gen/assets/standalone/*
!scene_gen/assets/standalone/README.md
# concrete_elements_asset_pack (2026-08-29): a 233 MB source usdz plus the
# per-prop USDs + textures split out of it by tools/extract_objects_to_usd.py
# --group-by-material. Same deal as `standalone/` — reproducible from the one
# command in its README.
scene_gen/assets/concrete_rubble_debris/*
!scene_gen/assets/concrete_rubble_debris/README.md
scene_gen/assets/archetypes_urban_v2/
scene_gen/_bakelab/

# Stage A bake outputs under a non-default --out root (2026-09-06): 38 GB of
# welded archetype USDs, same deal as `assets/archetypes/` above — rebuilt by
# `python3 scene_gen/archetypes/bake_cli.py --out assets/archetypes_welded`.
scene_gen/assets/archetypes_welded/
# Bake-parameter sweeps (assets/_lab/xsweep): one full-size USD per knob
# setting, 4 GB, kept only long enough to compare renders.
scene_gen/assets/_lab/
# Scratch output of the bake-stall investigation — one asset, its previews and
# the trace that recorded where it hung.
scene_gen/_stalltest/
