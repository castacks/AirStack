# Downloaded UE4 scene binaries (fetched via assets/scenes/fetch_scene.sh)
simulation/ms-airsim/assets/scenes/*
!simulation/ms-airsim/assets/scenes/fetch_scene.sh

# Test results
tests/results/

# Per-feature agent notebook: TRACKED on the airstack-paper branch (the
# agent-study notebook must travel between machines; develop keeps it
# local-only via its own .gitignore — expect a trivial conflict here on
# rebase, resolve in favor of this branch).
# See .agents/skills/use-feature-notebook
# Exception: raw demo-video screen captures (~750 MB) stay local-only;
# the final deliverables are committed under docs/assets/media/.
notebook/005-landing-page-demo-video/results/a-isaac-footage/
notebook/005-landing-page-demo-video/results/b-foxglove-footage/
notebook/005-landing-page-demo-video/results/c-msairsim-footage/
notebook/005-landing-page-demo-video/results/d-hero-video/

# Local-only — embedded sibling repo, not part of this branch
common/rayfronts/

# Docker build cache (root-owned subdirs cause permission warnings on `git add`)
robot/docker/cache/

# Ephemeral outputs from docker_image_plan.py (docker-build.yml)
docker-image-plan.json
docker-compose.fingerprint.yaml

.DS_Store
gcs/.DS_Store

# Per-run resolved launch config dumps (airstack up)
/.airstack/runs/

# AirStack modules (RFC #379) — synced checkouts + overlay artifacts are
# local-only; trunk never carries module code. See docs/development/modules.md
/modules/
/modules.repos
/modules.lock
robot/ros_ws/src/modules/
simulation/isaac-sim/launch_scripts/modules/
stacks/.external/
/.airstack/generated/

# Machine-local config overlay (RFC #380 §1/§3): per-serial calibration and
# local overrides — never shared through trunk. The README stays committed.
/config/local/*
!/config/local/README.md
