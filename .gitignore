# Persisted waypoint/polygon editor saves (host-side mount target)
gcs/saves/*
!gcs/saves/.gitkeep

# Downloaded UE4 scene binaries (fetched via assets/scenes/fetch_scene.sh)
simulation/ms-airsim/assets/scenes/*
!simulation/ms-airsim/assets/scenes/fetch_scene.sh

# Test results
tests/results/

# Local-only — embedded sibling repo, not part of this branch
common/rayfronts/

# Docker build cache (root-owned subdirs cause permission warnings on `git add`)
robot/docker/cache/
.DS_Store
gcs/.DS_Store

# Objaverse assets: converted USDs + textures are large and reproducible.
# manifest.yaml is committed; `scene_gen/prepare_assets.py` rebuilds it from the asset sets.
scene_gen/assets/objaverse/*
!scene_gen/assets/objaverse/manifest.yaml

# NVIDIA AEC demo packs (Brownstone / City Tower): vendor content, gigabytes,
# re-extractable from the downloaded zips. See scene_gen/assets/aec/README.md.
scene_gen/assets/aec/*
!scene_gen/assets/aec/README.md

# Layout plan PNGs and the asset manifest — generated, not source.
scene_gen/_plans/
scene_gen/_scene_assets.tsv

# Jupyter collaborative-editing store: a multi-GB-capable SQLite CRDT log that
# rebuilds itself on server start. Was pushed once at 85 MB.
.jupyter_ystore.db
.jupyter_ystore.db-journal
.jupyter_ystore.db-wal
.jupyter_ystore.db-shm
.jupyter/collaboration_sessions.json

# Scene-generation outputs. Exported USD scenes run to hundreds of MB and are
# reproducible from config; render_usd.py preview sheets/frames likewise.
scene_gen/**/*.usd
scene_gen/**/*.usda
scene_gen/**/*.usdc
scene_gen/**/*.usdz
scene_gen/**/_frames/
scene_gen/**/*_preview.png
# ...EXCEPT these, which are hand-authored SOURCE, not output. They are tiny
# UsdShade wrappers that give the AEC pack's bare `.mdl` ground materials the
# USD layer `usds.materials` requires. Ignoring them breaks a fresh clone: the
# asset set points at files that were never checked in.
!scene_gen/assets/materials/*.usda
scene_gen/**/*_turntable.gif
scene_gen/assets/baked/
scene_gen/assets/archetypes/
scene_gen/assets/materials/scorched/
nucleus_upload/

# ---- model weights ----------------------------------------------------------
# Never source: every one of these is fetched at runtime (ultralytics
# auto-download, HuggingFace hub) or baked into the image. They are also large
# enough to matter — robot/docker/cache alone is ~29 GB, already ignored above.
# Listed by extension as well as by path so a weight dropped anywhere (the
# ultralytics default is the CWD, which is how yolov8l-world.pt landed in
# robot/ros_ws/) does not get committed by accident.
scene_gen/assets/.hf/
*.pt
*.pth
*.safetensors
*.onnx
*.ckpt
robot/ros_ws/weights/

osmo/results/*
# OSMO mission bag/log staging (bind-mounted at /osmo_bags); keep the dir, drop the payload
osmo/bags/*
!osmo/bags/.gitkeep
osmo/weights/*
.agent_logs/*
.agent_tmp/*

# Frozen dataset scenes — large binary USD + textures, not source.
final_disaster_dataset/

# Paper source is maintained as a separate Overleaf Git repository.
/overleaf/
