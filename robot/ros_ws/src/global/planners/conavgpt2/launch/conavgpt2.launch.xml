<launch>
  <!-- Team size. One process drives the whole team, as upstream does, but AirStack
       puts each robot on its own ROS_DOMAIN_ID, so >1 needs the peers' camera
       topics to be visible on this domain. See the README. -->
  <arg name="num_robots" default="$(env NUM_ROBOTS 1)" />
  <arg name="robot_name_template" default="robot_{i}" />

  <!-- Topics. Defaults are the AirStack names; override to retarget. -->
  <arg name="rgb_topic_template"
       default="/{robot}/sensors/front_stereo/left/image_rect" />
  <arg name="depth_topic_template"
       default="/{robot}/sensors/front_stereo/left/depth_ground_truth" />
  <arg name="camera_info_topic_template"
       default="/{robot}/sensors/front_stereo/left/camera_info" />
  <arg name="odom_topic_template"
       default="/{robot}/odometry_conversion/odometry" />
  <arg name="navigate_action_template" default="/{robot}/tasks/navigate" />
  <arg name="global_plan_topic_template" default="/{robot}/global_plan" />

  <arg name="results_dir" default="" />

  <!-- OpenAI-compatible VLM endpoint. Left empty the node falls through to the
       environment (OPENAI_BASE_URL / CONAVGPT2_VLM_MODEL / OPENAI_API_KEY) and
       then to the package defaults, so the env path needs no arg at all. -->
  <arg name="vlm_base_url" default="" />
  <arg name="vlm_model" default="" />
  <arg name="vlm_api_key" default="" />

  <!-- Two params-file overlays layered on conavgpt2.yaml, applied in this
       order so the later one wins:

         method_params_file   what the ALGORITHM is: assignment cadence,
                              detector threshold. conavgpt2_paper.yaml restores
                              upstream's own defaults for fidelity runs.
         scene_params_file    what the WORLD is: map extent, obstacle band,
                              flight altitude, target class. Wins over method,
                              because upstream's 24 m indoor grid cannot
                              describe a 1600 m plat.

       Each defaults to the SAME file as the base, so "no overlay" just loads
       conavgpt2.yaml again — a no-op, and cheaper than a conditional
       `<param>`, which launch_xml does not support.

       NOTE an individual `<param name=...>` below BEATS a `<param from=...>`
       file whatever order they are written in, so nothing an overlay is meant
       to set may also appear as a `<param name>` here. goal_name, nav_mode,
       map_extent_m and round_period_s were removed for exactly that reason —
       set them in an overlay, or as a ros-args parameter on `ros2 run`. -->
  <arg name="method_params_file"
       default="$(find-pkg-share conavgpt2)/config/conavgpt2.yaml" />
  <arg name="scene_params_file"
       default="$(find-pkg-share conavgpt2)/config/conavgpt2.yaml" />

  <node pkg="conavgpt2" exec="conavgpt2_node" name="conavgpt2" output="screen">
    <param from="$(find-pkg-share conavgpt2)/config/conavgpt2.yaml"
           allow_substs="true" />
    <param name="use_sim_time" value="true" />

    <param name="num_robots" value="$(var num_robots)" />
    <param name="robot_name_template" value="$(var robot_name_template)" />
    <param name="rgb_topic_template" value="$(var rgb_topic_template)" />
    <param name="depth_topic_template" value="$(var depth_topic_template)" />
    <param name="camera_info_topic_template" value="$(var camera_info_topic_template)" />
    <param name="odom_topic_template" value="$(var odom_topic_template)" />
    <param name="navigate_action_template" value="$(var navigate_action_template)" />
    <param name="global_plan_topic_template" value="$(var global_plan_topic_template)" />
    <param name="results_dir" value="$(var results_dir)" />
    <param name="vlm_base_url" value="$(var vlm_base_url)" />
    <param name="vlm_model" value="$(var vlm_model)" />
    <param name="vlm_api_key" value="$(var vlm_api_key)" />

    <param from="$(var method_params_file)" allow_substs="true" />
    <param from="$(var scene_params_file)" allow_substs="true" />
  </node>
</launch>
