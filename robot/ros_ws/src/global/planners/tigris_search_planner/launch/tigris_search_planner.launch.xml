<!--
  tigris_search_planner : canonical module launch file (RFC #379 §2/§4).

  Starts the single-agent TIGRIS planner (node `tigris_search_planner`) at the
  robot root namespace. It serves the same SearchMission interface as
  mtl_search_planner, so the follower and the metrics logger are unchanged.
  Every topic/action endpoint is a declared <arg> with its canonical default,
  applied locally with <set_remap>; cross-module rewiring lives only in stack
  entry files (single-locus rule).
-->
<launch>
  <arg name="tigris_search_planner_config"
       default="$(find-pkg-share tigris_search_planner)/config/tigris_search_planner.yaml"
       description="Node parameter YAML (loaded with allow_substs)" />
  <arg name="tigris_search_planner_scenario_file"
       default="/root/AirStack/stacks/tigris_search/config/scenario.json"
       description="Scenario JSON generated by scripts/tigris_generate_scenario.py" />
  <arg name="tigris_search_planner_agent_name"
       default="$(env ROBOT_NAME)"
       description="Which scenario team agent this robot flies (team.agents[].name)" />
  <arg name="tigris_search_planner_runs_root"
       default="$(env MTL_RUNS_ROOT /root/AirStack/runs)"
       description="Root of the run output folders (runs/RUN_ID/AGENT/)" />

  <arg name="tigris_search_planner_action"
       default="/$(env ROBOT_NAME)/search_mission"
       description="SearchMission action server name (mtl_msgs/action/SearchMission)" />
  <arg name="tigris_search_planner_plan_topic"
       default="/$(env ROBOT_NAME)/search/plan"
       description="Output sortie for the follower and logger (mtl_msgs/SearchPlan, transient local; revised in flight)" />
  <arg name="tigris_search_planner_trajectory_topic"
       default="/$(env ROBOT_NAME)/search/planned_trajectory"
       description="Output planned track (airstack_msgs/TrajectoryXYZVYaw, transient local)" />
  <arg name="tigris_search_planner_boresight_topic"
       default="/$(env ROBOT_NAME)/search/planned_boresight"
       description="Output boresight ground points of the body-fixed camera (nav_msgs/Path, transient local)" />
  <arg name="tigris_search_planner_path_topic"
       default="/$(env ROBOT_NAME)/search/planned_path"
       description="Output flight track visualisation (nav_msgs/Path, transient local)" />
  <arg name="tigris_search_planner_markers_topic"
       default="/$(env ROBOT_NAME)/search/markers"
       description="Output search area / cells markers (visualization_msgs/MarkerArray)" />
  <arg name="tigris_search_planner_status_topic"
       default="/$(env ROBOT_NAME)/search/tigris_status"
       description="Output JSON record of the latest TIGRIS solve (std_msgs/String, transient local)" />
  <arg name="tigris_search_planner_follower_status_topic"
       default="/$(env ROBOT_NAME)/search/follower_status"
       description="Input follower progress (mtl_msgs/FollowerStatus)" />
  <arg name="tigris_search_planner_odometry_topic"
       default="/$(env ROBOT_NAME)/odometry_conversion/odometry"
       description="Input robot odometry (nav_msgs/Odometry): start pose, flown looks, flown length" />
  <arg name="tigris_search_planner_gimbal_state_topic"
       default="/$(env ROBOT_NAME)/gimbal/state"
       description="Input MEASURED gimbal angles (geometry_msgs/Vector3): the flown looks" />
  <arg name="tigris_search_planner_gimbal_cmd_topic"
       default="/$(env ROBOT_NAME)/gimbal/cmd_pitch_yaw"
       description="Input commanded gimbal angles (fallback when no measurement)" />
  <arg name="tigris_search_planner_abort_topic"
       default="/$(env ROBOT_NAME)/search/abort"
       description="Output abort request on goal cancel (std_msgs/Empty)" />

  <group>
    <set_remap from="search_mission" to="$(var tigris_search_planner_action)" />
    <set_remap from="odometry" to="$(var tigris_search_planner_odometry_topic)" />
    <set_remap from="gimbal/state" to="$(var tigris_search_planner_gimbal_state_topic)" />
    <set_remap from="gimbal/cmd_pitch_yaw" to="$(var tigris_search_planner_gimbal_cmd_topic)" />
    <set_remap from="search/plan" to="$(var tigris_search_planner_plan_topic)" />
    <set_remap from="search/planned_trajectory" to="$(var tigris_search_planner_trajectory_topic)" />
    <set_remap from="search/planned_boresight" to="$(var tigris_search_planner_boresight_topic)" />
    <set_remap from="search/planned_path" to="$(var tigris_search_planner_path_topic)" />
    <set_remap from="search/markers" to="$(var tigris_search_planner_markers_topic)" />
    <set_remap from="search/tigris_status" to="$(var tigris_search_planner_status_topic)" />
    <set_remap from="search/follower_status" to="$(var tigris_search_planner_follower_status_topic)" />
    <set_remap from="search/abort" to="$(var tigris_search_planner_abort_topic)" />

    <node pkg="tigris_search_planner" exec="tigris_search_planner_node" name="tigris_search_planner" output="screen">
      <param from="$(var tigris_search_planner_config)" allow_substs="true" />
      <param name="scenario_file" value="$(var tigris_search_planner_scenario_file)" />
      <param name="agent_name" value="$(var tigris_search_planner_agent_name)" />
      <param name="runs_root" value="$(var tigris_search_planner_runs_root)" />
    </node>
  </group>
</launch>
