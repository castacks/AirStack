<!--
  mtl_search_planner : canonical module launch file (RFC #379 §2/§4).

  Starts the MTL search planner (node `mtl_search_planner`) at the robot root
  namespace (the stack entry is included under the $ROBOT_NAME push in
  robot.launch.xml). Every topic/action endpoint is a declared <arg> with its
  canonical default, applied locally with <set_remap>; cross-module rewiring
  lives only in stack entry files (single-locus rule).
-->
<launch>
  <arg name="mtl_search_planner_config"
       default="$(find-pkg-share mtl_search_planner)/config/mtl_search_planner.yaml"
       description="Node parameter YAML (loaded with allow_substs)" />
  <arg name="mtl_search_planner_scenario_file"
       default="/root/AirStack/stacks/mtl_search/config/scenario.json"
       description="Scenario JSON (mtl.scenario/1 superset) generated by scripts/mtl_generate_scenario.py" />
  <arg name="mtl_search_planner_agent_name"
       default="$(env ROBOT_NAME)"
       description="Which scenario team agent this robot flies (team.agents[].name)" />
  <arg name="mtl_search_planner_runs_root"
       default="$(env MTL_RUNS_ROOT /root/AirStack/runs)"
       description="Root of the run output folders (runs/RUN_ID/AGENT/)" />

  <arg name="mtl_search_planner_action"
       default="/$(env ROBOT_NAME)/search_mission"
       description="SearchMission action server name (mtl_msgs/action/SearchMission)" />
  <arg name="mtl_search_planner_plan_topic"
       default="/$(env ROBOT_NAME)/search/plan"
       description="Output atomic sortie for the follower and logger (mtl_msgs/SearchPlan, transient local)" />
  <arg name="mtl_search_planner_trajectory_topic"
       default="/$(env ROBOT_NAME)/search/planned_trajectory"
       description="Output planned track (airstack_msgs/TrajectoryXYZVYaw, transient local)" />
  <arg name="mtl_search_planner_boresight_topic"
       default="/$(env ROBOT_NAME)/search/planned_boresight"
       description="Output scheduled boresight ground points (nav_msgs/Path, transient local)" />
  <arg name="mtl_search_planner_path_topic"
       default="/$(env ROBOT_NAME)/search/planned_path"
       description="Output flight track visualisation (nav_msgs/Path, transient local)" />
  <arg name="mtl_search_planner_markers_topic"
       default="/$(env ROBOT_NAME)/search/markers"
       description="Output search area / cells / teammate markers (visualization_msgs/MarkerArray)" />
  <arg name="mtl_search_planner_follower_status_topic"
       default="/$(env ROBOT_NAME)/search/follower_status"
       description="Input follower progress (mtl_msgs/FollowerStatus)" />
  <arg name="mtl_search_planner_odometry_topic"
       default="/$(env ROBOT_NAME)/odometry_conversion/odometry"
       description="Input robot odometry (nav_msgs/Odometry): action feedback position and measured flown length" />
  <arg name="mtl_search_planner_abort_topic"
       default="/$(env ROBOT_NAME)/search/abort"
       description="Output abort request on goal cancel (std_msgs/Empty)" />

  <group>
    <set_remap from="search_mission" to="$(var mtl_search_planner_action)" />
    <set_remap from="odometry" to="$(var mtl_search_planner_odometry_topic)" />
    <set_remap from="search/plan" to="$(var mtl_search_planner_plan_topic)" />
    <set_remap from="search/planned_trajectory" to="$(var mtl_search_planner_trajectory_topic)" />
    <set_remap from="search/planned_boresight" to="$(var mtl_search_planner_boresight_topic)" />
    <set_remap from="search/planned_path" to="$(var mtl_search_planner_path_topic)" />
    <set_remap from="search/markers" to="$(var mtl_search_planner_markers_topic)" />
    <set_remap from="search/follower_status" to="$(var mtl_search_planner_follower_status_topic)" />
    <set_remap from="search/abort" to="$(var mtl_search_planner_abort_topic)" />

    <node pkg="mtl_search_planner" exec="mtl_search_planner_node" name="mtl_search_planner" output="screen">
      <param from="$(var mtl_search_planner_config)" allow_substs="true" />
      <param name="scenario_file" value="$(var mtl_search_planner_scenario_file)" />
      <param name="agent_name" value="$(var mtl_search_planner_agent_name)" />
      <param name="runs_root" value="$(var mtl_search_planner_runs_root)" />
    </node>
  </group>
</launch>
