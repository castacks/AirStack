<launch>
    <!-- ModalAI interface for Isaac Sim.
         Run Isaac Sim first with modalai_voxl2_pegasus_launch_script.py,
         then launch this file. -->
    <include file="$(find-pkg-share modalai_interface)/launch/modalai_interface.launch.xml">
        <arg name="use_sim_qvio_bridge" value="true" />
        <arg name="voxl_qvio_topic"     value="/qvio" />
        <!-- PX4 SITL namespaces all FMU topics under px4_1/fmu -->
        <arg name="fmu_namespace"        value="px4_1/fmu" />
        <arg name="px4_namespace"        value="px4_1" />
    </include>
</launch>
