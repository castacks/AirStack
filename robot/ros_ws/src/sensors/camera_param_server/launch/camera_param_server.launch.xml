<!-- camera_param_server: serves camera intrinsics/extrinsics from the YAML
     named by CAMERA_CONFIG_FILE.
     Included by: nothing in trunk (run manually on hardware camera setups).
     STATUS: standalone utility. -->
<launch>
    <node pkg="camera_param_server" exec="camera_param_server" name="camera_param_server" output="screen">
        <param name="camera_config" value="$(env CAMERA_CONFIG_FILE /config/camera_config.yaml)"/>
    </node>
</launch>