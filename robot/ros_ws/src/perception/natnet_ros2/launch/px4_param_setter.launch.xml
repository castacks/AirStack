<?xml version="1.0"?>
<launch>
  <!--
    PX4 Parameter Setter Launch File

    Enforces the external-vision PX4 parameter set (config/px4_params.yaml)
    through the MAVROS param plugin once at startup. Included from
    natnet_ros2.launch.py when the robot's vision_pose block is enabled.

    Services (provided by MAVROS param plugin):
      /{ROBOT_NAME}/interface/mavros/param/get_parameters
      /{ROBOT_NAME}/interface/mavros/param/set
  -->

  <arg name="config_file"
       default="$(find-pkg-share natnet_ros2)/config/px4_params.yaml"
       description="ROS 2 parameter YAML (params.* = desired FCU parameters)"/>

  <arg name="use_sim_time" default="false"
       description="Forwarded after YAML so sim stacks can force true"/>

  <node pkg="natnet_ros2" exec="px4_param_setter_node.py"
        name="px4_param_setter" output="screen">
    <param from="$(var config_file)" allow_substs="true"/>

    <remap from="param_get_parameters"
           to="/$(env ROBOT_NAME robot_1)/interface/mavros/param/get_parameters"/>
    <remap from="param_set"
           to="/$(env ROBOT_NAME robot_1)/interface/mavros/param/set"/>
    <remap from="mavros_state"
           to="/$(env ROBOT_NAME robot_1)/interface/mavros/state"/>

    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

</launch>
