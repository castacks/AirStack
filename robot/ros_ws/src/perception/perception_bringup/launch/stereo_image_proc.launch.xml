<!--
  stereo_image_proc : canonical module launch file (RFC #379 §2/§4).

  Starts the stereo disparity + point-cloud pair exactly as the legacy
  perception bringup did: `disparity_node` in the `stereo_image_proc`
  sub-namespace and the `stereo_pointcloud` point-cloud node directly in the
  perception namespace. Every topic endpoint is a declared <arg> defaulting
  to the canonical name (today's graph). Wiring deviations are passed as
  include args by the stack entry file (stacks/<name>/launch/) — the
  single-locus rule: no remap tags and no cross-module rewiring edits here.

  Note: the legacy file also carried a remap from
  /$ROBOT_NAME/stereo_image_proc/disparity — a dead rule (the node resolves
  `disparity` inside /$ROBOT_NAME/perception/stereo_image_proc, which never
  matched that source), dropped here with no graph change.
-->
<launch>
  <arg name="stereo_image_proc_namespace"
       default="perception"
       description="Namespace to run in; 'perception' so outputs land on the canonical /$ROBOT_NAME/perception/stereo_image_proc/* topics" />

  <arg name="stereo_image_proc_left_image_topic"
       default="/$(env ROBOT_NAME)/sensors/front_stereo/left/image_rect"
       description="Input left rectified image (sensor_msgs/Image); also used as the point-cloud node's color image" />
  <arg name="stereo_image_proc_left_camera_info_topic"
       default="/$(env ROBOT_NAME)/sensors/front_stereo/left/camera_info"
       description="Input left camera info (sensor_msgs/CameraInfo)" />
  <arg name="stereo_image_proc_right_image_topic"
       default="/$(env ROBOT_NAME)/sensors/front_stereo/right/image_rect"
       description="Input right rectified image (sensor_msgs/Image)" />
  <arg name="stereo_image_proc_right_camera_info_topic"
       default="/$(env ROBOT_NAME)/sensors/front_stereo/right/camera_info"
       description="Input right camera info (sensor_msgs/CameraInfo)" />

  <arg name="stereo_image_proc_disparity_topic"
       default="/$(env ROBOT_NAME)/perception/stereo_image_proc/disparity"
       description="Output disparity image (stereo_msgs/DisparityImage); also the point-cloud node's disparity input" />
  <arg name="stereo_image_proc_point_cloud_topic"
       default="/$(env ROBOT_NAME)/perception/stereo_image_proc/point_cloud"
       description="Output stereo point cloud (sensor_msgs/PointCloud2)" />

  <group>
    <push-ros-namespace namespace="$(var stereo_image_proc_namespace)" />
    <!-- Sources are relative, so each rule resolves against the node that
         carries the endpoint (disparity_node consumes left/image_rect;
         the point-cloud node consumes left/image_rect_color). -->
    <set_remap from="left/image_rect" to="$(var stereo_image_proc_left_image_topic)" />
    <set_remap from="left/image_rect_color" to="$(var stereo_image_proc_left_image_topic)" />
    <set_remap from="right/image_rect" to="$(var stereo_image_proc_right_image_topic)" />
    <set_remap from="left/camera_info" to="$(var stereo_image_proc_left_camera_info_topic)" />
    <set_remap from="right/camera_info" to="$(var stereo_image_proc_right_camera_info_topic)" />
    <set_remap from="disparity" to="$(var stereo_image_proc_disparity_topic)" />
    <set_remap from="points2" to="$(var stereo_image_proc_point_cloud_topic)" />

    <!-- Disparity estimation -->
    <node pkg="stereo_image_proc" exec="disparity_node"
        namespace="stereo_image_proc">
      <param name="speckle_size" value="300" />
      <param name="approximate_sync" value="true" />
    </node>

    <!-- Point cloud generation -->
    <node pkg="stereo_image_proc" exec="point_cloud_node"
        name="stereo_pointcloud" output="screen">
      <param name="approximate_sync" value="true" />
    </node>
  </group>
</launch>
