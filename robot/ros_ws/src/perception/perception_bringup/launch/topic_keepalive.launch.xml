<!--
  topic_keepalive : canonical module launch file (RFC #379 §2/§4).

  Keeps Isaac Sim's on-demand publishers alive by subscribing silently (see
  scripts/topic_keepalive_node.py). The node declares no topic endpoints —
  it only creates subscribers from its built-in list — so there are no topic
  args to expose. Runs at the robot root namespace (the stack entry is
  included under the $ROBOT_NAME push in robot.launch.xml), matching the
  legacy perception bringup's node path /$ROBOT_NAME/topic_keepalive.
-->
<launch>
  <node pkg="perception_bringup" exec="topic_keepalive_node.py"
        name="topic_keepalive" output="screen" />
</launch>
