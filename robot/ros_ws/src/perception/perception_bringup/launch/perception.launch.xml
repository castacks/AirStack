<!-- PERCEPTION -->
<launch>
    <arg name="launch_stereo_image_proc" default="true" />

    <group>
        <push-ros-namespace namespace="perception" />
        <!-- State and depth estimation -->
        <!-- MAC-VO moved out of trunk: the asm_macvo module ships its own
             canonical launch (macvo_ros2/launch/macvo.launch.xml); stacks that
             want it include that file directly (see stacks/full_macvo). -->

        <group if="$(var launch_stereo_image_proc)">
            <!-- Disparity Estimation -->
            <node pkg="stereo_image_proc" exec="disparity_node"
                namespace="stereo_image_proc">
                <!-- inputs -->
                <remap from="left/image_rect"
                    to="/$(env ROBOT_NAME)/sensors/front_stereo/left/image_rect" />
                <remap from="left/camera_info"
                    to="/$(env ROBOT_NAME)/sensors/front_stereo/left/camera_info" />
                <remap from="right/image_rect"
                    to="/$(env ROBOT_NAME)/sensors/front_stereo/right/image_rect" />
                <remap from="right/camera_info"
                    to="/$(env ROBOT_NAME)/sensors/front_stereo/right/camera_info" />

                <!-- outputs -->
                <remap from="/$(env ROBOT_NAME)/stereo_image_proc/disparity"
                    to="/$(env ROBOT_NAME)/perception/stereo_image_proc/disparity" />

                <param name="speckle_size" value="300" />
                <param name="approximate_sync" value="true" />
            </node>
            <!-- Point Cloud Generation -->
            <node
                pkg="stereo_image_proc"
                exec="point_cloud_node"
                name="stereo_pointcloud"
                output="screen">

                <!-- inputs -->
                <remap from="left/image_rect_color"
                    to="/$(env ROBOT_NAME)/sensors/front_stereo/left/image_rect" />
                <remap from="left/camera_info"
                    to="/$(env ROBOT_NAME)/sensors/front_stereo/left/camera_info" />
                <remap from="right/camera_info"
                    to="/$(env ROBOT_NAME)/sensors/front_stereo/right/camera_info" />

                <!-- outputs -->
                <remap from="disparity" to="/$(env ROBOT_NAME)/perception/stereo_image_proc/disparity" />
                <remap from="points2" to="/$(env ROBOT_NAME)/perception/stereo_image_proc/point_cloud" />
                <param name="approximate_sync" value="true" />
            </node>
        </group>

    </group>

    <node pkg="perception_bringup" exec="topic_keepalive_node.py"
          name="topic_keepalive" output="screen" />

</launch>