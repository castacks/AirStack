<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mighty</name>
  <version>0.1.0</version>
  <description>
    MIGHTY: Hermite spline-based Efficient Trajectory Planning (Kondo et al.,
    RA-L 2026). asm_mighty port: ROS 2 Jazzy, Gazebo Classic targets and the
    ground-robot MPC path removed; decomp_rviz_plugins dependency replaced by
    the headers-only decomp_ros_utils shim.
  </description>
  <maintainer email="kkondo@mit.edu">Kota Kondo</maintainer>
  <maintainer email="ajong@andrew.cmu.edu">Andrew Jong (asm_mighty port)</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>rclpy</depend>
  <depend>rclcpp_components</depend>
  <depend>example_interfaces</depend>
  <depend>dynus_interfaces</depend>
  <depend>visualization_msgs</depend>
  <depend>decomp_util</depend>
  <depend>decomp_ros_msgs</depend>
  <depend>decomp_ros_utils</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>pcl_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>nlohmann-json-dev</depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
