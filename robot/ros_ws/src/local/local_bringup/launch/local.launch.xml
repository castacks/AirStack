<!-- LOCAL -->
<launch>
    <!-- WARNING: ROS2 does NOT scope launch arguments. Make sure they have unique names -->
    <arg name="local_odometry_in_topic" default="/$(env ROBOT_NAME)/odometry_conversion/odometry" />
    <!-- <arg name="local_disparity_in_topic" default="/$(env
    ROBOT_NAME)/perception/macvo/disparity" /> -->
    <!-- <arg name="local_depth_in_topic" default="none" /> -->
    <arg name="local_disparity_in_topic" default="/$(env ROBOT_NAME)/perception/stereo_image_proc/disparity" />
    <!-- <arg name="local_depth_in_topic" default="/$(env
    ROBOT_NAME)/sensors/front_stereo/right/depth_ground_truth" /> -->
    <arg name="local_depth_in_topic" default="none" />
    <arg name="local_camera_info_in_topic"
        default="/$(env ROBOT_NAME)/sensors/front_stereo/right/camera_info" />

    <log message="local_odometry_in_topic has $(var local_odometry_in_topic)" />

    <!-- WHICH LOCAL PLANNER serves /tasks/navigate and steers by /global_plan.
         'droan'  droan_gl (GPU rollouts over the disparity image) — historical
         'mighty' asm_mighty: MIGHTY Hermite-spline planner over an acl-mapping
                  voxel map built from the STEREO cloud, behind the same
                  NavigateTask / trajectory_controller seam (vendored under
                  modules/asm_mighty, see its ORIGIN.md). The 2026-08-27
                  eval swapped to it: droan spent its time spinning in place,
                  MIGHTY flies smooth straight paths to the same waypoints.
         From LOCAL_PLANNER (compose passes it through); empty/unset = droan.
         The search planners read the same variable to pick their activation
         (search_baselines planner.yaml nav_activation: auto). -->
    <arg name="local_planner" default="$(env LOCAL_PLANNER droan)" />
    <log message="local_planner is '$(var local_planner)'" />


    <!-- Takeoff/Landing Task Action Servers -->
    <node pkg="takeoff_landing_planner" exec="takeoff_landing_task"
          namespace="takeoff_landing_planner" output="screen">
        <param from="$(find-pkg-share takeoff_landing_planner)/config/takeoff_landing_planner.yaml"
            allow_substs="true" />
        <remap from="trajectory_override"
            to="/$(env ROBOT_NAME)/trajectory_controller/trajectory_override" />
        <remap from="set_trajectory_mode"
            to="/$(env ROBOT_NAME)/trajectory_controller/set_trajectory_mode" />
        <remap from="tracking_point"
            to="/$(env ROBOT_NAME)/trajectory_controller/tracking_point" />
        <remap from="odometry" to="$(var local_odometry_in_topic)" />
        <remap from="is_armed" to="/$(env ROBOT_NAME)/interface/is_armed" />
        <remap from="has_control" to="/$(env ROBOT_NAME)/interface/has_control" />
        <remap from="state_estimate_timed_out"
            to="/$(env ROBOT_NAME)/behavior/drone_safety_monitor/state_estimate_timed_out" />
        <remap from="extended_state"
            to="/$(env ROBOT_NAME)/interface/mavros/extended_state" />
        <remap from="robot_command"
            to="/$(env ROBOT_NAME)/interface/robot_command" />
        <remap from="~/takeoff_task" to="/$(env ROBOT_NAME)/tasks/takeoff" />
        <remap from="~/land_task" to="/$(env ROBOT_NAME)/tasks/land" />
    </node>

    <!-- Fixed Trajectory Task Action Server -->
    <node pkg="trajectory_controller" exec="fixed_trajectory_task"
          namespace="trajectory_controller" output="screen">
        <remap from="trajectory_override"
            to="/$(env ROBOT_NAME)/trajectory_controller/trajectory_override" />
        <remap from="set_trajectory_mode"
            to="/$(env ROBOT_NAME)/trajectory_controller/set_trajectory_mode" />
        <remap from="trajectory_completion_percentage"
            to="/$(env ROBOT_NAME)/trajectory_controller/trajectory_completion_percentage" />
        <remap from="odometry" to="$(var local_odometry_in_topic)" />
        <remap from="~/fixed_trajectory_task" to="/$(env ROBOT_NAME)/tasks/fixed_trajectory" />
    </node>

    <group if="$(eval '&quot;$(var local_planner)&quot; == &quot;mighty&quot;')">
        <!-- MIGHTY (asm_mighty): mapper + planner + NavigateTask bridge, in the
             `mighty` sub-namespace. Wiring the module's stack file would do:
             our configs, the stereo cloud instead of an Ouster, and the frame
             that cloud is expressed in (stereo_image_proc publishes it in the
             LEFT camera's optical frame, `camera_left`). -->
        <include file="$(find-pkg-share mighty_bridge)/launch/mighty_module.launch.xml">
            <arg name="mighty_config"
                 value="$(find-pkg-share local_bringup)/config/mighty_disaster.yaml" />
            <arg name="mighty_mapper_config"
                 value="$(find-pkg-share local_bringup)/config/global_mapper_disaster.yaml" />
            <arg name="mighty_lidar_topic"
                 value="/$(env ROBOT_NAME)/$(env MIGHTY_CLOUD_SUFFIX perception/stereo_image_proc/point_cloud)" />
            <arg name="mighty_lidar_frame" value="$(env MIGHTY_CLOUD_FRAME camera_left)" />
            <arg name="mighty_odometry_topic" value="$(var local_odometry_in_topic)" />
            <!-- The bridge only starts following /global_plan once
                 `z - z0 > follow_min_climb_m` AND |vz| < 0.2. Its default is
                 8.0 m, which this file never overrode — so any mission taking
                 off below ~8.2 m hung forever with the drone hovering and the
                 gate logging `follower gate: ... climb_needed=8.0` on repeat
                 (measured 2026-09-02: 768 consecutive failures at z=2.7 m,
                 term_goal never published, raven planning into a void).
                 1.0 m is enough to mean "airborne and settled" — the |vz|
                 condition is what actually waits for the climb to finish, so
                 this does not engage the follower mid-climb. It also removes a
                 knife-edge: `> 8.0` against an 8.0 m takeoff that settles
                 ~0.15 m short (0.3 m acceptance) can never pass, which is the
                 same latent hang in frontier_vs_raven_compare.yaml. -->
            <arg name="mighty_follow_min_climb_m" value="1.0" />
        </include>
    </group>

    <group unless="$(eval '&quot;$(var local_planner)&quot; == &quot;mighty&quot;')">
        <push-ros-namespace namespace="droan" />
        <!-- DROAN Local Planner -->
        <node pkg="droan_gl" exec="droan_gl_node" output="screen"
              respawn="true" respawn_delay="1.0">
            <remap from="~/navigate_task" to="/$(env ROBOT_NAME)/tasks/navigate" />
            <remap from="set_trajectory_mode" to="/$(env ROBOT_NAME)/trajectory_controller/set_trajectory_mode" />
            <remap from="disparity" to="$(var local_disparity_in_topic)" />
            <remap from="global_plan" to="/$(env ROBOT_NAME)/global_plan" />
            <remap from="look_ahead" to="/$(env ROBOT_NAME)/trajectory_controller/look_ahead" />
            <remap from="tracking_point"
                to="/$(env ROBOT_NAME)/trajectory_controller/tracking_point" />
            <remap from="camera_info" to="$(var local_camera_info_in_topic)" />
            <remap from="trajectory_segment_to_add"
                to="/$(env ROBOT_NAME)/trajectory_controller/trajectory_segment_to_add" />

            <param name="target_frame" value="map" />
            <param name="look_ahead_frame" value="look_ahead_point_stabilized" />
            <param name="rewind_info_frame" value="base_link_stabilized" />
            <param name="visualize" value="true" />
            <param name="graph_nodes" value="10" />
            <param name="expansion_radius" value="2." />
            <param name="seen_radius" value="1." />
            <!-- 1, not the historical 2: a vertical takeoff leaves droan a column of
                 views under the hover point and every candidate "unseen" (see
                 droan_gl_node.cpp). One view is enough to leave the pad; the graph
                 refills with overlapping views as soon as the drone moves. -->
            <param name="min_seen_views" value="1" />
            <param name="dt" value="0.2" />
            <param name="ht" value="7." />
            <param name="downsample_scale" value="2" />
            <param name="graph_distance_threshold" value="1." />
            <param name="graph_angle_threshold" value="30." />
            <param name="all_in_collision_duration_threshold" value="2." />
            <param name="all_in_collision_rewind_duration" value="6." />
            <param name="stationary_distance_threshold" value="0.5" />
            <param name="stationary_history_duration" value="10." />
            <param name="stationary_rewind_distance" value="10." />
            <param name="stationary_rewind_duration" value="20." />
        </node>
        <?ignore
        <node pkg="disparity_expansion" exec="disparity_expansion" name="disparity_expansion"
            output="screen">
            <param
                from="$(find-pkg-share disparity_expansion)/config/disparity_expansion_params.yaml" />

            <remap from="disparity" to="$(var local_disparity_in_topic)" />
            <remap from="depth" to="$(var local_depth_in_topic)" />
            <remap from="camera_info" to="$(var local_camera_info_in_topic)" />
        </node>
        ?>
    </group>

    <!-- Control -->
    <!-- customize trajectory_controller.launch.xml -->
    <node pkg="trajectory_controller" exec="trajectory_controller"
        namespace="trajectory_controller"
        output="screen">
        <param name="tf_prefix" value="" />
        <param name="target_frame" value="map" />
        <param name="tracking_point_distance_limit" value="1000.5" />
        <param name="velocity_look_ahead_time" value="0.9" />
        <!-- look ahead time controls the speed, greater is faster -->
        <param name="look_ahead_time" value="1.0" />
        <param name="virtual_tracking_ahead_time" value="0.5" />
        <param name="min_virtual_tracking_velocity" value="0.5" />
        <param name="sphere_radius" value="1.0" />
        <param name="ff_min_velocity" value="0." />
        <param name="search_ahead_factor" value="1.5" />
        <param name="transition_velocity_scale" value="1.0" />
        <param name="traj_vis_thickness" value="0.03" />
        <param name="rewind_skip_max_velocity" value="0.1" />
        <param name="rewind_skip_max_distance" value="0.1" />
        <param name="velocity_sphere_radius_multiplier" value="1.0" />

        <!-- remap glue to AirStack -->
        <remap from="odometry" to="$(var local_odometry_in_topic)" />

    </node>

    <node pkg="pid_controller" exec="pid_controller" namespace="control" output="screen">
        <param name="target_frame" value="base_link_stabilized" />

        <param name="x_p" value="1.0" />
        <param name="x_i" value="0.0" />
        <param name="x_d" value="0.0" />
        <param name="x_ff" value="0.0" />
        <param name="x_d_alpha" value="0.0" />
        <param name="x_min" value="-3.0" />
        <param name="x_max" value="3.0" />
        <param name="x_constant" value="0.0" />

        <param name="y_p" value="1.0" />
        <param name="y_i" value="0.0" />
        <param name="y_d" value="0.0" />
        <param name="y_ff" value="0.0" />
        <param name="y_d_alpha" value="0.0" />
        <param name="y_min" value="-3.0" />
        <param name="y_max" value="3.0" />
        <param name="y_constant" value="0.0" />

        <param name="z_p" value="1.0" />
        <param name="z_i" value="0.0" />
        <param name="z_d" value="0.0" />
        <param name="z_ff" value="0.0" />
        <param name="z_d_alpha" value="0.0" />
        <param name="z_min" value="-1.0" />
        <param name="z_max" value="1.0" />
        <param name="z_constant" value="0.0" />

        <param name="vx_p" value="0.2" />
        <param name="vx_i" value="0.025" />
        <param name="vx_d" value="0.0" />
        <param name="vx_ff" value="0.0" />
        <param name="vx_d_alpha" value="0.9" />
        <param name="vx_min" value="-0.34" />
        <param name="vx_max" value="0.34" />
        <param name="vx_constant" value="0.0" />

        <param name="vy_p" value="0.2" />
        <param name="vy_i" value="0.025" />
        <param name="vy_d" value="0.0" />
        <param name="vy_ff" value="0.0" />
        <param name="vy_d_alpha" value="0.9" />
        <param name="vy_min" value="-0.34" />
        <param name="vy_max" value="0.34" />
        <param name="vy_constant" value="0.0" />

        <param name="vz_p" value="0.2" />
        <param name="vz_i" value="0.1" />
        <param name="vz_d" value="0.0" />
        <param name="vz_ff" value="0.0" />
        <param name="vz_d_alpha" value="0.0" />
        <param name="vz_min" value="-0.5" />
        <param name="vz_max" value="1.0" />
        <param name="vz_constant" value="0.5" />

        <!-- remap glue to AirStack -->
        <remap from="odometry" to="$(var local_odometry_in_topic)" />
        <remap from="tracking_point" to="/$(env ROBOT_NAME)/trajectory_controller/tracking_point" />
        <remap from="command" to="/$(env ROBOT_NAME)/interface/cmd_roll_pitch_yawrate_thrust" />
    </node>
    <?ignore
  <node pkg="rviz2" exec="rviz2"
    args="-d $(find-pkg-share local_bringup)/rviz/droan.rviz --ros-args --log-level INFO"
    output="screen" respawn="true" respawn_delay="1" />
  ?>

  	<?ignore
        <node pkg="droan_local_planner" exec="droan_local_planner" output="screen"
            args="--log-level DEBUG">
            <param from="$(find-pkg-share droan_local_planner)/config/droan.yaml"
                allow_substs="true" />
            <remap from="~/navigate_task" to="/$(env ROBOT_NAME)/tasks/navigate" />
            <remap from="set_trajectory_mode" to="/$(env ROBOT_NAME)/trajectory_controller/set_trajectory_mode" />
            <remap from="global_plan" to="/$(env ROBOT_NAME)/global_plan" />
            <remap from="look_ahead" to="/$(env ROBOT_NAME)/trajectory_controller/look_ahead" />
            <remap from="tracking_point"
                to="/$(env ROBOT_NAME)/trajectory_controller/tracking_point" />
            <!-- we use right because The baseline (\(B\)) is encoded in the last column of the right camera's projection matrix. -->
            <remap from="camera_info" to="$(var local_camera_info_in_topic)" />
            <remap from="trajectory_segment_to_add"
                to="/$(env ROBOT_NAME)/trajectory_controller/trajectory_segment_to_add" />
          </node>
	  ?>


</launch>
