<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pid_controller</name>
  <version>0.0.0</version>
  <description>Cascaded PID controller that tracks the trajectory controller's tracking point against odometry and publishes roll/pitch/yaw-rate/thrust commands.</description>
  <maintainer email="ajong@andrew.cmu.edu">Andrew Jong</maintainer>
  <license>BSD-3-Clause-Clear</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>mav_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pid_controller_msgs</depend>
  <depend>airstack_msgs</depend>
  <depend>airstack_common</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
