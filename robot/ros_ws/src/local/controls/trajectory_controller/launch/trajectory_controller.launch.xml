<!--
  trajectory_controller : canonical module launch file (RFC #379 §2/§4).

  Starts the trajectory controller as the legacy local bringup did: node
  `trajectory_control_node` (the executable's self-declared name) in the
  `trajectory_controller` namespace. Its command topics (trajectory_override,
  trajectory_segment_to_add, set_trajectory_mode, tracking_point, look_ahead,
  ...) live under that namespace by relative name — the canonical
  /$ROBOT_NAME/trajectory_controller/* group. Every external topic endpoint
  is a declared <arg> defaulting to the canonical name (today's graph).
  Wiring deviations are passed as include args by the stack entry file
  (stacks/<name>/launch/) — the single-locus rule: endpoints are declared args,
  applied locally via <set_remap>; cross-module REWIRING lives only in
  stack entry files.
-->
<launch>
  <arg name="trajectory_controller_config"
       default="$(find-pkg-share trajectory_controller)/config/trajectory_controller.yaml"
       description="Node parameter YAML (loaded with allow_substs)" />

  <arg name="trajectory_controller_odometry_topic"
       default="/$(env ROBOT_NAME)/odometry_conversion/odometry"
       description="Input robot odometry (nav_msgs/Odometry)" />

  <group>
    <push-ros-namespace namespace="trajectory_controller" />
    <set_remap from="odometry" to="$(var trajectory_controller_odometry_topic)" />

    <node pkg="trajectory_controller" exec="trajectory_controller" output="screen">
      <param from="$(var trajectory_controller_config)" allow_substs="true" />
    </node>
  </group>
</launch>
