<launch>
  <arg name="vision_planner_name" default="external_planner" />
  <arg name="vision_planner_namespace" default="vision_planner" />
  <arg name="vision_planner_image_in_topic"
       default="/$(env ROBOT_NAME)/sensors/front_stereo/left/image_rect" />
  <arg name="vision_planner_camera_info_in_topic"
       default="/$(env ROBOT_NAME)/sensors/front_stereo/left/camera_info" />
  <arg name="vision_planner_depth_in_topic"
       default="/$(env ROBOT_NAME)/sensors/front_stereo/left/depth_ground_truth" />
  <arg name="vision_planner_odometry_in_topic"
       default="/$(env ROBOT_NAME)/odometry_conversion/odometry" />
  <arg name="vision_planner_trajectory_out_topic"
       default="/$(env ROBOT_NAME)/trajectory_controller/trajectory_segment_to_add" />
  <arg name="vision_planner_trajectory_override_topic"
       default="/$(env ROBOT_NAME)/trajectory_controller/trajectory_override" />
  <arg name="vision_planner_mode_service"
       default="/$(env ROBOT_NAME)/trajectory_controller/set_trajectory_mode" />
  <arg name="vision_planner_config"
       default="$(find-pkg-share mononav_bridge)/config/mononav_bridge.yaml" />
  <arg name="vision_planner_execute_commands" default="false" />

  <group>
    <push-ros-namespace namespace="$(var vision_planner_namespace)" />
    <node pkg="mononav_bridge" exec="mononav_bridge_node"
          name="bridge" output="screen">
      <param from="$(var vision_planner_config)" allow_substs="true" />
      <param name="planner_name" value="$(var vision_planner_name)" />
      <param name="execute_commands" value="$(var vision_planner_execute_commands)" />
      <remap from="image" to="$(var vision_planner_image_in_topic)" />
      <remap from="camera_info" to="$(var vision_planner_camera_info_in_topic)" />
      <remap from="depth_image" to="$(var vision_planner_depth_in_topic)" />
      <remap from="odometry" to="$(var vision_planner_odometry_in_topic)" />
      <remap from="trajectory_segment" to="$(var vision_planner_trajectory_out_topic)" />
      <remap from="trajectory_override"
             to="$(var vision_planner_trajectory_override_topic)" />
      <remap from="set_trajectory_mode" to="$(var vision_planner_mode_service)" />
      <remap from="trajectory_markers"
             to="/$(env ROBOT_NAME)/$(var vision_planner_namespace)/trajectory_markers" />
      <remap from="status"
             to="/$(env ROBOT_NAME)/$(var vision_planner_namespace)/status" />
    </node>
  </group>
</launch>
