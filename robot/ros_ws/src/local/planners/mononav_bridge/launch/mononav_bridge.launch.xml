<launch>
  <arg name="mononav_bridge_image_in_topic"
       default="/$(env ROBOT_NAME)/sensors/front_stereo/left/image_rect" />
  <arg name="mononav_bridge_camera_info_in_topic"
       default="/$(env ROBOT_NAME)/sensors/front_stereo/left/camera_info" />
  <arg name="mononav_bridge_depth_in_topic"
       default="/$(env ROBOT_NAME)/sensors/front_stereo/left/depth_ground_truth" />
  <arg name="mononav_bridge_odometry_in_topic"
       default="/$(env ROBOT_NAME)/odometry_conversion/odometry" />
  <arg name="mononav_bridge_trajectory_out_topic"
       default="/$(env ROBOT_NAME)/trajectory_controller/trajectory_segment_to_add" />
  <arg name="mononav_bridge_trajectory_override_topic"
       default="/$(env ROBOT_NAME)/trajectory_controller/trajectory_override" />
  <arg name="mononav_bridge_mode_service"
       default="/$(env ROBOT_NAME)/trajectory_controller/set_trajectory_mode" />
  <arg name="mononav_bridge_config"
       default="$(find-pkg-share mononav_bridge)/config/mononav_bridge.yaml" />
  <arg name="mononav_bridge_execute_commands" default="false" />

  <group>
    <push-ros-namespace namespace="mononav" />
    <node pkg="mononav_bridge" exec="mononav_bridge_node"
          name="bridge" output="screen">
      <param from="$(var mononav_bridge_config)" allow_substs="true" />
      <param name="execute_commands" value="$(var mononav_bridge_execute_commands)" />
      <remap from="image" to="$(var mononav_bridge_image_in_topic)" />
      <remap from="camera_info" to="$(var mononav_bridge_camera_info_in_topic)" />
      <remap from="depth_image" to="$(var mononav_bridge_depth_in_topic)" />
      <remap from="odometry" to="$(var mononav_bridge_odometry_in_topic)" />
      <remap from="trajectory_segment" to="$(var mononav_bridge_trajectory_out_topic)" />
      <remap from="trajectory_override"
             to="$(var mononav_bridge_trajectory_override_topic)" />
      <remap from="set_trajectory_mode" to="$(var mononav_bridge_mode_service)" />
      <remap from="trajectory_markers"
             to="/$(env ROBOT_NAME)/mononav/trajectory_markers" />
      <remap from="status" to="/$(env ROBOT_NAME)/mononav/status" />
    </node>
  </group>
</launch>
