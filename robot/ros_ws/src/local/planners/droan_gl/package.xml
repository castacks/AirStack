<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>droan_gl</name>
  <version>0.0.0</version>
  <description>GPU-accelerated DROAN local planner that performs true-sphere disparity-space obstacle expansion and collision checking with OpenGL shaders.</description>
  <maintainer email="ajong@andrew.cmu.edu">Andrew Jong</maintainer>
  <license>BSD-3-Clause-Clear</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>task_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>stereo_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>ament_index_cpp</depend>
  <depend>pcl_conversions</depend>
  <depend>airstack_common</depend>
  <depend>airstack_msgs</depend>
  <depend>trajectory_library</depend>

  <!-- System libraries linked/included by droan_gl_node (CMakeLists
       target_link_libraries: glfw dl assimp EGL GL; headers: <glm/*>).
       rosdep keys verified against the jazzy/noble db:
         assimp        -> libassimp-dev
         opengl        -> libgl1-mesa-dev libglu1-mesa-dev  (GL)
         libglfw3-dev  -> libglfw3-dev
         libglm-dev    -> libglm-dev
       EGL has NO rosdep key on Ubuntu 24.04 (libegl-dev / libegl1-mesa-dev
       do not resolve); libegl-dev is installed explicitly in
       robot/docker/Dockerfile.robot alongside these. -->
  <depend>assimp</depend>
  <depend>opengl</depend>
  <depend>libglfw3-dev</depend>
  <depend>libglm-dev</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>