<!--
  takeoff_landing_planner : canonical module launch file (RFC #379 §2/§4).

  Starts the takeoff/land task action server as the legacy local bringup did:
  node `takeoff_landing_task` in the `takeoff_landing_planner` namespace.
  Every topic endpoint is a declared <arg> defaulting to the canonical name
  (today's graph). Wiring deviations are passed as include args by the stack
  entry file (stacks/<name>/launch/) — the single-locus rule: no remap tags and
  no cross-module rewiring edits here.
-->
<launch>
  <arg name="takeoff_landing_config"
       default="$(find-pkg-share takeoff_landing_planner)/config/takeoff_landing_planner.yaml"
       description="Node parameter YAML (loaded with allow_substs)" />

  <arg name="takeoff_landing_odometry_topic"
       default="/$(env ROBOT_NAME)/odometry_conversion/odometry"
       description="Input robot odometry (nav_msgs/Odometry)" />
  <arg name="takeoff_landing_trajectory_override_topic"
       default="/$(env ROBOT_NAME)/trajectory_controller/trajectory_override"
       description="Output takeoff/land trajectory override (airstack_msgs/TrajectoryXYZVYaw)" />
  <arg name="takeoff_landing_set_trajectory_mode_topic"
       default="/$(env ROBOT_NAME)/trajectory_controller/set_trajectory_mode"
       description="Output trajectory-controller mode command" />
  <arg name="takeoff_landing_tracking_point_topic"
       default="/$(env ROBOT_NAME)/trajectory_controller/tracking_point"
       description="Input trajectory-controller tracking point (nav_msgs/Odometry)" />
  <arg name="takeoff_landing_is_armed_topic"
       default="/$(env ROBOT_NAME)/interface/is_armed"
       description="Input arming state from the robot interface (std_msgs/Bool)" />
  <arg name="takeoff_landing_has_control_topic"
       default="/$(env ROBOT_NAME)/interface/has_control"
       description="Input offboard-control state from the robot interface (std_msgs/Bool)" />
  <arg name="takeoff_landing_state_estimate_timed_out_topic"
       default="/$(env ROBOT_NAME)/behavior/drone_safety_monitor/state_estimate_timed_out"
       description="Input state-estimate timeout flag from the safety monitor (std_msgs/Bool)" />
  <arg name="takeoff_landing_extended_state_topic"
       default="/$(env ROBOT_NAME)/interface/mavros/extended_state"
       description="Input MAVROS extended state (mavros_msgs/ExtendedState)" />
  <arg name="takeoff_landing_robot_command_topic"
       default="/$(env ROBOT_NAME)/interface/robot_command"
       description="Output robot command (arm/disarm etc.) to the robot interface" />
  <arg name="takeoff_landing_takeoff_task_action"
       default="/$(env ROBOT_NAME)/tasks/takeoff"
       description="Takeoff task action server name (task_msgs)" />
  <arg name="takeoff_landing_land_task_action"
       default="/$(env ROBOT_NAME)/tasks/land"
       description="Land task action server name (task_msgs)" />

  <group>
    <push-ros-namespace namespace="takeoff_landing_planner" />
    <set_remap from="odometry" to="$(var takeoff_landing_odometry_topic)" />
    <set_remap from="trajectory_override" to="$(var takeoff_landing_trajectory_override_topic)" />
    <set_remap from="set_trajectory_mode" to="$(var takeoff_landing_set_trajectory_mode_topic)" />
    <set_remap from="tracking_point" to="$(var takeoff_landing_tracking_point_topic)" />
    <set_remap from="is_armed" to="$(var takeoff_landing_is_armed_topic)" />
    <set_remap from="has_control" to="$(var takeoff_landing_has_control_topic)" />
    <set_remap from="state_estimate_timed_out" to="$(var takeoff_landing_state_estimate_timed_out_topic)" />
    <set_remap from="extended_state" to="$(var takeoff_landing_extended_state_topic)" />
    <set_remap from="robot_command" to="$(var takeoff_landing_robot_command_topic)" />
    <set_remap from="~/takeoff_task" to="$(var takeoff_landing_takeoff_task_action)" />
    <set_remap from="~/land_task" to="$(var takeoff_landing_land_task_action)" />

    <node pkg="takeoff_landing_planner" exec="takeoff_landing_task" output="screen">
      <param from="$(var takeoff_landing_config)" allow_substs="true" />
    </node>
  </group>
</launch>
