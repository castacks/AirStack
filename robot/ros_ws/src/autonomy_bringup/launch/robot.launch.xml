<!-- Single entry point for all robot deployments.
     role choices:
       full     - all autonomy modules run on this machine (default: sim/dev desktop, autonomous Jetson)
       onboard  - lite modules only: interface, sensors, perception, local planning, behavior (VOXL, Jetson
lite, desktop_split sim)
       offboard - global planning only: runs on GCS paired with onboard robots (robot-offboard service)
-->
<launch>
  <arg name="sim" default="true" />
  <arg name="role" default="$(env AUTONOMY_ROLE full)" />
  <!-- Stack dispatch (RFC #379 S3, as on upstream develop / airstack-paper):
       when `airstack up` with the stack flag (or AIRSTACK_STACK in .env) exports
       AIRSTACK_STACK_DIR / AIRSTACK_STACK_ENTRY (CONTAINER paths; stacks/ is
       bind-mounted at /root/AirStack/stacks), the stack folder's entry file
       stacks/<name>/launch/<entry>.launch.xml composes the whole autonomy
       graph and the role dispatch below is skipped. 'none' = no stack: the
       legacy AUTONOMY_ROLE layers. The shared preamble (namespace, sim time,
       robot_state_publisher, world->map) runs for both. -->
  <arg name="stack_dir" default="$(env AIRSTACK_STACK_DIR none)" />
  <arg name="stack_entry" default="$(env AIRSTACK_STACK_ENTRY stack)" />
  <arg name="urdf_file" default="$(env URDF_FILE iris_with_sensors.pegasus.robot.urdf)" />
  <arg name="gcs_domain" default="0" />
  <arg name="gossip_domain" default="99" />
  <arg name="gossip_publish_rate" default="1.0" />

  <push_ros_namespace namespace="$(env ROBOT_NAME)" />

  <set_parameter name="use_sim_time" value="true" if="$(var sim)" />

  <!-- Robot State Publisher -->
  <include file="$(find-pkg-share robot_descriptions)/launch/robot_state_publisher.launch.py">
    <arg name="robot_name" value="$(env ROBOT_NAME)" />
    <arg name="urdf_file_path" value="$(var urdf_file)" />
    <arg name="ignore_timestamp" value="true" />
    <arg name="use_sim_time" value="$(var sim)" />
  </include>

  <!-- world -> map.
       IDENTITY IS A LIE whenever the drone does not spawn at the world origin.
       `map` is anchored at the TAKEOFF POINT (PX4's local origin comes from the
       GPS home position, which gps_utils.set_gps_origins derives from the spawn
       pose), so odometry, TF, /global_plan and any grid published in `map` sit
       offset from world by exactly the spawn offset — while the sim's overhead
       ground texture and the GCS robot markers are in world ENU. Measured:
       45 m on the house bench (DRONE_XY=0,-45), 340 m on suburb_wildfire.
       The default DRONE_CONFIGS spawn at the origin, which is why this has
       never shown up.

       Left as identity by DEFAULT because making it truthful changes the frame
       every previously recorded mission replays in. MAP_ANCHOR_ENU=true swaps
       in a node that MEASURES the offset (world ENU from the GPS fix minus the
       same instant's odometry) and publishes that instead. -->
  <arg name="map_anchor_enu" default="$(env MAP_ANCHOR_ENU false)" />

  <group unless="$(eval '&quot;$(var map_anchor_enu)&quot;.lower() == &quot;true&quot;')">
    <node pkg="tf2_ros" exec="static_transform_publisher"
      name="world_to_map_broadcaster"
      args="0 0 0 0 0 0 world map" />
  </group>

  <group if="$(eval '&quot;$(var map_anchor_enu)&quot;.lower() == &quot;true&quot;')">
    <node pkg="coordination_bringup" exec="map_anchor_node"
      name="world_to_map_broadcaster" output="screen">
      <param name="spawn_height_m" value="$(env SPAWN_HEIGHT_M 0.0)" />
    </node>
  </group>

  <!-- ── Stack dispatch ──────────────────────────────────────────────── -->
  <group if="$(eval '&quot;$(var stack_dir)&quot; not in (&quot;none&quot;, &quot;&quot;)')">
    <log message="stack dispatch: $(var stack_dir)/launch/$(var stack_entry).launch.xml" />
    <include file="$(var stack_dir)/launch/$(var stack_entry).launch.xml">
      <arg name="gcs_domain" value="$(var gcs_domain)" />
      <arg name="gossip_domain" value="$(var gossip_domain)" />
      <arg name="gossip_publish_rate" value="$(var gossip_publish_rate)" />
    </include>
  </group>

  <!-- ── Role dispatch (legacy, no stack selected) ────────────────────── -->

  <!-- full: every autonomy module runs here -->
  <group if="$(eval '&quot;$(var role)&quot; == &quot;full&quot; and &quot;$(var stack_dir)&quot; in (&quot;none&quot;, &quot;&quot;)')">
    <include
      file="$(find-pkg-share autonomy_bringup)/onboard_all/launch/onboard_autonomy_all.launch.xml" />

    <!-- Domain Bridge (GCS) -->
    <include file="$(find-pkg-share autonomy_bringup)/launch/interpolate_dds_router.launch.py">
      <arg name="config_file"
        value="$(find-pkg-share autonomy_bringup)/onboard_all/config/dds_router.yaml" />
      <arg name="args" value="gcs_domain:=$(var gcs_domain)" />
    </include>

    <!-- Gossip coordination layer -->
    <include file="$(find-pkg-share coordination_bringup)/launch/gossip.launch.xml">
      <arg name="gossip_domain"  value="$(var gossip_domain)" />
      <arg name="publish_rate"   value="$(var gossip_publish_rate)" />
    </include>
  </group>

  <!-- onboard: lite modules only (local planning, perception, etc.); global is handled offboard -->
  <group if="$(eval '&quot;$(var role)&quot; == &quot;onboard&quot; and &quot;$(var stack_dir)&quot; in (&quot;none&quot;, &quot;&quot;)')">
    <include
      file="$(find-pkg-share autonomy_bringup)/onboard_local_offboard_global/launch/onboard_autonomy_local.launch.xml" />

    <!-- Domain Bridge (GCS) -->
    <include file="$(find-pkg-share autonomy_bringup)/launch/interpolate_dds_router.launch.py">
      <arg name="config_file"
        value="$(find-pkg-share autonomy_bringup)/onboard_local_offboard_global/config/dds_router.yaml" />
      <arg name="args" value="gcs_domain:=$(var gcs_domain)" />
    </include>

    <!-- Gossip coordination layer -->
    <include file="$(find-pkg-share coordination_bringup)/launch/gossip.launch.xml">
      <arg name="gossip_domain"  value="$(var gossip_domain)" />
      <arg name="publish_rate"   value="$(var gossip_publish_rate)" />
    </include>

  </group>

  <!-- offboard: global planning only; runs on GCS paired with onboard robots -->
  <group if="$(eval '&quot;$(var role)&quot; == &quot;offboard&quot; and &quot;$(var stack_dir)&quot; in (&quot;none&quot;, &quot;&quot;)')">
    <include
      file="$(find-pkg-share autonomy_bringup)/onboard_local_offboard_global/launch/offboard_autonomy_global.launch.xml" />
  </group>

</launch>