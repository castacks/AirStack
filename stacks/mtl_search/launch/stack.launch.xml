<!--
  mtl_search : Multi-Agent Target Localization search stack.

  Per robot: fly this robot's row of a TEAM search plan (mtl::planner, vendored)
  with a native earth-stabilised camera gimbal, and score detections of the
  scenario's ground-truth targets online.

    interface -> perception (keepalive) -> [takeoff/land, safety]
      -> mtl_search_planner  (/<robot>/search_mission action; search/plan,
                              search/planned_trajectory, search/planned_boresight)
      -> mtl_trajectory_follower (arc-length carrot pursuit + gimbal law, 20 Hz)
      -> trajectory_controller / pid_controller
      -> mtl_metrics_logger (runs/<run_id>/<robot>/{telemetry.csv,detection.json,report.html})

  ONE WIRING DEVIATION from canonical (the single locus for it is this file):
  the trajectory controller's tracking point is moved to
  trajectory_controller/tracking_point_nominal, and mtl_trajectory_follower
  owns the canonical trajectory_controller/tracking_point. The follower
  forwards the nominal point verbatim whenever no search is active (takeoff,
  land, hover), publishes its carrot while searching, and hands control back
  with set_trajectory_mode(ROBOT_POSE) when the search ends or aborts. Every
  consumer of tracking_point (pid_controller, ...) is therefore unchanged.

  Everything else is canonical (bare includes). The scenario bundle
  (scenario.json / ground_truth.json / belief.png) lives in this stack's
  config/ and is generated by scripts/mtl_generate_scenario.py from
  config/mission.yaml + config/fleets/mtl_search_fleet.yaml.

  Launched by autonomy_bringup/launch/robot.launch.xml under the ROBOT_NAME
  namespace push when AIRSTACK_STACK_DIR points at this folder
  (`airstack up` with stack mtl_search).
-->
<launch>
  <arg name="mtl_config_dir"
       default="$(env AIRSTACK_STACK_DIR /root/AirStack/stacks/mtl_search)/config"
       description="Folder holding the scenario bundle (scenario.json, ground_truth.json, belief.png) and the stack-local controller / DDS-router configs" />
  <arg name="mtl_runs_root"
       default="$(env MTL_RUNS_ROOT /root/AirStack/runs)"
       description="Where run folders (runs/RUN_ID/AGENT/...) are written; mounted from the repo's runs/ folder" />
  <arg name="gcs_domain" default="0"
       description="GCS ROS domain the DDS router bridges this robot's allowlisted topics to" />

  <!-- ── Interface (wrapped by design: MAVROS + safety boundary) ─────────── -->
  <include file="$(find-pkg-share interface_bringup)/launch/interface.launch.py" />

  <!-- ── Perception ──────────────────────────────────────────────────────── -->
  <!-- Keeps Isaac Sim's on-demand publishers alive with rviz off -->
  <include file="$(find-pkg-share perception_bringup)/launch/topic_keepalive.launch.xml" />

  <!-- ── Local tasks + behavior (canonical) ──────────────────────────────── -->
  <!-- Takeoff/Land task server: actions at tasks/{takeoff,land} -->
  <include file="$(find-pkg-share takeoff_landing_planner)/launch/takeoff_landing_planner.launch.xml" />

  <!-- Safety monitor: odometry watchdog; its state_estimate_timed_out also
       aborts an active search in the follower -->
  <include file="$(find-pkg-share drone_safety_monitor)/launch/drone_safety_monitor.launch.xml" />

  <!-- ── Global: team search planner ─────────────────────────────────────── -->
  <!-- Plans the scenario's TEAM problem (deterministic; every robot gets the
       same plan) and flies its own agent row; action /<robot>/search_mission -->
  <include file="$(find-pkg-share mtl_search_planner)/launch/mtl_search_planner.launch.xml">
    <arg name="mtl_search_planner_scenario_file" value="$(var mtl_config_dir)/scenario.json" />
    <arg name="mtl_search_planner_runs_root" value="$(var mtl_runs_root)" />
  </include>

  <!-- ── Local: search follower (tracking-point arbiter + gimbal law) ───── -->
  <include file="$(find-pkg-share mtl_trajectory_follower)/launch/mtl_trajectory_follower.launch.xml" />

  <!-- Trajectory controller, with its tracking point MOVED to
       tracking_point_nominal (see header). The group scopes the remap to
       this include only. -->
  <group>
    <set_remap from="/$(env ROBOT_NAME)/trajectory_controller/tracking_point"
               to="/$(env ROBOT_NAME)/trajectory_controller/tracking_point_nominal" />
    <include file="$(find-pkg-share trajectory_controller)/launch/trajectory_controller.launch.xml" />
  </group>

  <!-- PID controller: reads the (arbitrated) canonical tracking_point; the
       stack-local gains only lift the horizontal speed clamp to the plan
       speed (see the file's header) -->
  <include file="$(find-pkg-share pid_controller)/launch/pid_controller.launch.xml">
    <arg name="pid_controller_config" value="$(var mtl_config_dir)/pid_controller_mtl.yaml" />
  </include>

  <!-- ── Logging: online detection scoring + run report ──────────────────── -->
  <include file="$(find-pkg-share mtl_metrics_logger)/launch/mtl_metrics_logger.launch.xml">
    <arg name="mtl_metrics_logger_scenario_file" value="$(var mtl_config_dir)/scenario.json" />
    <arg name="mtl_metrics_logger_runs_root" value="$(var mtl_runs_root)" />
  </include>

  <!-- ── Cross-domain extras ─────────────────────────────────────────────── -->
  <!-- DDS Router: the shared allowlist plus the search / gimbal topics and
       the search_mission + takeoff/land actions (stack-local copy) -->
  <include file="$(find-pkg-share autonomy_bringup)/launch/interpolate_dds_router.launch.py">
    <arg name="dds_router_config_file" value="$(var mtl_config_dir)/dds_router_mtl_search.yaml" />
    <arg name="dds_router_args" value="gcs_domain:=$(var gcs_domain)" />
  </include>

  <!-- Gossip coordination layer (historical robot.launch.xml defaults) -->
  <include file="$(find-pkg-share coordination_bringup)/launch/gossip.launch.xml">
    <arg name="gossip_domain" value="99" />
    <arg name="gossip_publish_rate" value="1.0" />
  </include>
</launch>
