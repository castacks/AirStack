# modules.repos : module pins for the neurosymbolic DEBUG stack (vcstool format,
# pinned to tags/commits). asm_mighty is full_default's local planner; asm_team_platform
# is the shared team platform (flight, allocation, find rule, scorer); the planners on it are
# asm_neurosymbolic (the method), asm_search_oracle (known-positions upper bound) and
# asm_search_baselines (lawnmower, coverage frontier). All COA-SEI, private: cloning needs
# GitHub access. To debug local checkouts instead: `airstack module add /path/to/<module>`.
airstack_compat: ">=0.21.0-dev.15 <0.22.0"
repositories:
  asm_mighty:
    type: git
    url: https://github.com/castacks/asm_mighty
    version: v0.1.5
  asm_neurosymbolic:
    type: git
    url: https://github.com/COA-SEI/asm_neurosymbolic
    version: 3f00de23d76bffc879f56bccd3ef31337e67affd
  asm_team_platform:
    type: git
    url: https://github.com/COA-SEI/asm_team_platform
    version: 311edc3bbc35b83a9e04f427980abd5a73e46cdf
  asm_search_oracle:
    type: git
    url: https://github.com/COA-SEI/asm_search_oracle
    version: 42c7e0e36737a83820fdd9e5e37e3c19410e9727
  asm_search_baselines:
    type: git
    url: https://github.com/COA-SEI/asm_search_baselines
    version: ec546ba5ebda1cddd10f754c0db4ec528dbb1cb2
x-local-modules: []
