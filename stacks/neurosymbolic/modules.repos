# modules.repos : module pins for the neurosymbolic DEBUG stack (vcstool format,
# pinned to tags/commits). asm_mighty is full_default's local planner; the method
# itself is the asm_neurosymbolic module (COA-SEI, private: cloning needs GitHub access).
# To debug a local checkout instead: `airstack module add /path/to/asm_neurosymbolic`.
airstack_compat: ">=0.21.0-dev.15 <0.22.0"
repositories:
  asm_mighty:
    type: git
    url: https://github.com/castacks/asm_mighty
    version: v0.1.5
  asm_neurosymbolic:
    type: git
    url: https://github.com/COA-SEI/asm_neurosymbolic
    version: b7383ff400b5fe6b98e1def91ea81442ce737c1c
  asm_team_platform:
    type: git
    url: https://github.com/COA-SEI/asm_team_platform
    version: ca4f0ff769cd59bac2df9ca0e6c9a324d4d508d4
  asm_search_oracle:
    type: git
    url: https://github.com/COA-SEI/asm_search_oracle
    version: 49e58ce0507bb0b84d4d77c318490dd1c8778ee6
  asm_search_baselines:
    type: git
    url: https://github.com/COA-SEI/asm_search_baselines
    version: 542a4bdb2c208034ef93b59c4dde7d45bffc8ea9
x-local-modules: []
