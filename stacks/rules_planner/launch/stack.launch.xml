<!--
  rules_planner : full_default plus the RayFronts semantic mapper and the
  task_assigner rules planner (COA-SEI/task_assigner, a local module).

  Copied from stacks/full_default and extended in two places, marked
  "rules_planner:" below. Everything else is the trunk reference topology;
  see stacks/full_default/launch/stack.launch.xml for the per-module notes.

    1. RayFronts (perception_bringup/launch/rayfronts.launch.xml, ported from
       the disaster-dataset branch): rgb/depth/pose in from the front stereo
       and odometry_conversion; per-label similarity clouds out under
       /$ROBOT_NAME/rayfronts/msg_serv/{voxels_sim,rays_sim}/<label>. Needs the
       robot image built with SKIP_RAYFRONTS=false (robot/docker/docker-compose.yaml
       does this) and a mapper vocabulary (common/rayfronts_configs).
    2. task_assigner rules planner (modules/task_assigner, launch/rules_planner.launch.py):
       RayFronts embeddings in; rules-planner tasks out on the task queue.
       It is a FLEET-level node: RULES_PLANNER=true (default) runs it in this
       container; set it false on every robot but one, or move the include to
       a ground host, so a fleet runs exactly one planner.
    3. task_assigner task executor (launch/task_executor.launch.py): PER ROBOT,
       in every container. Takes the tasks whose assigned_to maps to this robot
       (the fleet file's `robot_name` field) and flies them: a lawnmower for a
       sweep/survey polygon, fly-and-dwell for an investigate/confirm box,
       as tasks/navigate goals plus global_plan, reporting each transition on
       /dtc/rules_planner/task_status so the planner frees the drone.

  THE EXECUTOR REPLACES THE GLOBAL PLANNER. random_walk_planner publishes
  global_plan and drives tasks/navigate itself, so running both would leave two
  planners fighting over one local planner. The random-walk include below is
  therefore conditional on RULES_EXECUTOR being false: the same swap
  full_exploration and full_raven make, one include at a time.

  Not validated in simulation yet: the planning and execution logic is
  unit-tested in task_assigner/tests/rules; this stack is the wiring target.
-->
<launch>

  <!-- ── rules_planner arguments ─────────────────────────────────────────── -->

  <arg name="rules_fleet_file"
       default="$(find-pkg-share task_assigner)/config/rules_planner/examples/fleet_1large_2small.yaml"
       description="Fleet YAML shared by the planner and every executor. Its
                    `robot_name` field is the drone_id -> robot join
                    (large_1 -> robot_1, small_1 -> robot_2, small_2 -> robot_3)." />
  <arg name="rules_scenario_file"
       default="$(find-pkg-share task_assigner)/config/rules_planner/examples/earthquake_suburban_500m.yaml"
       description="ScenarioInput YAML the AOE prompt is built from." />
  <!-- Rule tunables: a path, or a bare filename resolved against the
       installed config/rules_planner (then its examples/). The shipped
       rules.yaml suits a dense low-altitude map; rules_sweep_70m.yaml is the
       high-altitude demo's gates. -->
  <arg name="rules_config" default="$(env RULES_CONFIG rules.yaml)"/>
  <arg name="rules_llm_backend" default="$(env RULES_LLM_BACKEND openai)"
       description="openai = the local OpenAI-compatible server, read from the
                    container environment (OPENAI_BASE_URL, RULES_LLM_MODEL);
                    fake = the offline backend, no model. From a robot
                    container the host's Ollama is
                    http://host.docker.internal:11434/v1 (robot_base maps that
                    alias to the docker host) or http://172.31.0.1:11434/v1." />
  <arg name="rules_planner_robot" default="$(env RULES_PLANNER_ROBOT robot_1)"
       description="Which robot hosts the ONE fleet-level planner (and its
                    dashboard). The robot containers are compose REPLICAS of a
                    single service, so they share one environment and
                    RULES_PLANNER cannot differ per replica: the planner is
                    selected by comparing this to each container's own
                    ROBOT_NAME. The executor runs on every robot regardless." />
  <arg name="rules_gt_people_file"
       default="$(env RULES_GT_PEOPLE /root/final_disaster_dataset/Earthquake/Suburban500/level_1/1/GT_people.json)"
       description="A frozen cell's GT_people.json AS THE ROBOT CONTAINER SEES
                    IT (robot-desktop mounts FINAL_DATASET_DIR read-only at
                    /root/final_disaster_dataset), drawn on
                    /dtc/rules_planner/gt_people. The default is the shipped
                    500 m suburban-earthquake cell, 9 survivors. A path that is
                    not there is a warning and an empty layer, not a failure." />
  <arg name="rules_dashboard" default="$(env RULES_DASHBOARD true)"
       description="Run the rules-planner dashboard beside the planner node." />
  <arg name="rules_dashboard_port" default="$(env RULES_DASHBOARD_PORT 8791)"
       description="Port that dashboard serves on (8790 is the DTC one)." />
  <arg name="rules_track_spacing_m" default="$(env RULES_TRACK_SPACING_M 25.0)"
       description="Lawnmower track spacing an executor covers a sweep/survey
                    polygon at." />
  <arg name="rules_takeoff_altitude_m" default="$(env RULES_TAKEOFF_ALTITUDE_M 10.0)"
       description="Altitude the executor's one automatic tasks/takeoff climbs to." />
  <arg name="rules_auto_takeoff" default="$(env RULES_AUTO_TAKEOFF true)"
       description="Request tasks/takeoff once before the first waypoint. False =
                    the operator takes off from the GCS Robot Tasks panel." />

  <!-- ── Interface (wrapped by design — see header) ──────────────────────── -->

  <!-- Interface (MAVROS/PX4 hardware interface + safety) -->
  <include file="$(find-pkg-share interface_bringup)/launch/interface.launch.py" />

  <!-- ── Sensors, flat ───────────────────────────────────────────────────── -->

  <!-- LiDAR near-range filter: raw ouster cloud in, filtered cloud out
       (canonical defaults, endpoints are node parameters). The namespace
       group keeps the legacy node path /$ROBOT_NAME/sensors/... -->
  <group>
    <push-ros-namespace namespace="sensors" />
    <include file="$(find-pkg-share lidar_point_cloud_filter)/launch/lidar_point_cloud_filter.launch.xml" />
  </group>

  <!-- ── Perception, flat ────────────────────────────────────────────────── -->

  <!-- Stereo disparity + point cloud (stereo_image_proc pair): rectified
       stereo pair in from sensors/front_stereo (canonical); disparity and
       point_cloud out under perception/stereo_image_proc. (MAC-VO comes via
       the asm_macvo module — see stacks/full_macvo; OptiTrack via the
       asm_optitrack module.) -->
  <include file="$(find-pkg-share perception_bringup)/launch/stereo_image_proc.launch.xml" />

  <!-- Topic keepalive: silently subscribes Isaac Sim's on-demand publishers
       so they keep publishing with rviz off; no topic endpoints declared -->
  <include file="$(find-pkg-share perception_bringup)/launch/topic_keepalive.launch.xml" />


  <!-- rules_planner: RayFronts semantic mapper (per-robot, GPU). -->
  <!-- Gated per robot: RAYFRONTS_ROBOTS=robot_1 runs the mapper only on the
       large drone (one RADIO mapper is ~4 GB of GPU; a 16 GB card shared with
       Isaac Sim fits one). RAYFRONTS_PER_ROBOT=false skips it everywhere
       (RAYFRONTS_MODE=shared on offboard-compute). -->
  <include file="$(find-pkg-share perception_bringup)/launch/rayfronts_gated.launch.py">
    <arg name="emb_enabled" value="true" />
  </include>

  <!-- ── Local layer, flat (module launch files; canonical defaults) ────── -->

  <!-- Takeoff/Land task server: odometry in from odometry_conversion;
       trajectory_override + mode out to the trajectory controller;
       arming/extended state from the interface; actions at tasks/{takeoff,land} -->
  <include file="$(find-pkg-share takeoff_landing_planner)/launch/takeoff_landing_planner.launch.xml" />

  <!-- Fixed-trajectory task server: trajectory_override + mode out to the
       trajectory controller; action at tasks/fixed_trajectory -->
  <include file="$(find-pkg-share trajectory_controller)/launch/fixed_trajectory_task.launch.xml" />

  <!-- MIGHTY local planner (asm_mighty module, CPU): filtered Ouster cloud in
       to its acl-mapping voxel world model, odometry in from
       odometry_conversion; trajectory_override out to the trajectory
       controller (the bridge sets TRACK mode itself); navigate action at
       tasks/navigate. The DROAN reactive planner is the same seam one
       include away (stacks/full_droan). -->
  <include file="$(find-pkg-share mighty_bridge)/launch/mighty_module.launch.xml" />

  <!-- Trajectory controller: odometry in from odometry_conversion; serves the
       trajectory_controller/* topic group (override, segment, mode, tracking
       point, look_ahead) by relative name in its namespace -->
  <include file="$(find-pkg-share trajectory_controller)/launch/trajectory_controller.launch.xml" />

  <!-- PID controller: odometry in from odometry_conversion, tracking_point in
       from the trajectory controller; attitude/thrust command out to the
       interface (cmd_roll_pitch_yawrate_thrust) -->
  <include file="$(find-pkg-share pid_controller)/launch/pid_controller.launch.xml" />

  <!-- ── Global, flat ────────────────────────────────────────────────────── -->

  <!-- Global world model: VDB occupancy map; filtered LiDAR cloud in, map
       visualization out (topics live in the params YAML — cross-package
       config owned by global_bringup, selected here). NOTE: 'config' is the
       arg name the vendored vdb_mapping_ros2 launch declares. -->
  <include file="$(find-pkg-share vdb_mapping_ros2)/launch/vdb_mapping_ros2.py">
    <arg name="config" value="$(find-pkg-share global_bringup)/config/vdb_params.yaml" />
  </include>

  <!-- Global planner: random walk. vdb map visualization + odometry in;
       global_plan out; navigate/exploration actions under tasks/*. The node
       self-names random_walk_node at the robot root (no namespace push).
       Swapping the global planner = replacing this include, e.g. with the
       asm_exploration_planner module's exploration_planner.launch.xml plus
       the global_plan_navigate_bridge (see stacks/full_exploration).

       rules_planner: OFF while the task executor is on. Both publish
       global_plan and both drive tasks/navigate, so they cannot coexist.
       RULES_EXECUTOR=false gets the trunk random walk back. -->
  <include unless="$(env RULES_EXECUTOR true)"
           file="$(find-pkg-share random_walk_planner)/launch/random_walk_planner.launch.xml" />


  <!-- rules_planner: task_assigner rules planner (fleet-level, one per fleet)
       plus its dashboard. ONE per fleet, and the selection is by NAME, not by
       flag: the robot containers are replicas of one compose service and share
       one environment, so rules_planner.launch.py starts its nodes only where
       ROBOT_NAME equals rules_planner_robot. Its /dtc/* topics are global, not
       namespaced: they reach the GCS and the other robots' executors through
       this robot's DDS router (see autonomy_bringup/config/dds_router.yaml). -->
  <include if="$(env RULES_PLANNER true)"
           file="$(find-pkg-share task_assigner)/launch/rules_planner.launch.py">
    <arg name="robot_name" value="$(env ROBOT_NAME)" />
    <arg name="planner_robot" value="$(var rules_planner_robot)" />
    <arg name="scenario_file" value="$(var rules_scenario_file)" />
    <arg name="rules_config" value="$(var rules_config)" />
    <arg name="fleet_file" value="$(var rules_fleet_file)" />
    <arg name="llm_backend" value="$(var rules_llm_backend)" />
    <arg name="gt_people_file" value="$(var rules_gt_people_file)" />
    <arg name="dashboard" value="$(var rules_dashboard)" />
    <arg name="dashboard_port" value="$(var rules_dashboard_port)" />
  </include>

  <!-- rules_planner: task executor (PER ROBOT, every container). Global
       planner for this stack: it turns the tasks assigned to this robot's
       drones into legs and reports back on /dtc/rules_planner/task_status.
       RULES_NAV_BACKEND (read by task_executor.launch.py itself) picks how a
       leg flies: trajectory_override straight onto the trajectory controller
       (default, no obstacle avoidance), or tasks/navigate + global_plan to
       the MIGHTY bridge. -->
  <include if="$(env RULES_EXECUTOR true)"
           file="$(find-pkg-share task_assigner)/launch/task_executor.launch.py">
    <arg name="robot_name" value="$(env ROBOT_NAME)" />
    <arg name="fleet_file" value="$(var rules_fleet_file)" />
    <arg name="track_spacing_m" value="$(var rules_track_spacing_m)" />
    <arg name="auto_takeoff" value="$(var rules_auto_takeoff)" />
    <arg name="takeoff_altitude_m" value="$(var rules_takeoff_altitude_m)" />
  </include>

  <!-- ── Behavior, flat ──────────────────────────────────────────────────── -->

  <!-- Safety monitor: odometry watchdog (state_estimate in from
       odometry_conversion); trajectory mode out to the trajectory controller
       on safety events -->
  <include file="$(find-pkg-share drone_safety_monitor)/launch/drone_safety_monitor.launch.xml" />

  <!-- ── Logging (already a single self-contained module — see header) ───── -->
  <include file="$(find-pkg-share logging_bringup)/launch/logging.launch.xml" />

  <!-- ── Cross-domain extras (formerly robot.launch.xml's full-role group) ─ -->

  <!-- Domain Bridge (GCS) -->
  <include file="$(find-pkg-share autonomy_bringup)/launch/interpolate_dds_router.launch.py">
    <arg name="dds_router_config_file"
      value="$(find-pkg-share autonomy_bringup)/config/dds_router.yaml" />
    <!-- 0 = robot.launch.xml's gcs_domain default -->
    <arg name="dds_router_args" value="gcs_domain:=0" />
  </include>

  <!-- Gossip coordination layer -->
  <include file="$(find-pkg-share coordination_bringup)/launch/gossip.launch.xml">
    <!-- 99 / 1.0 = robot.launch.xml's gossip_domain / gossip_publish_rate defaults -->
    <arg name="gossip_domain" value="99" />
    <arg name="gossip_publish_rate" value="1.0" />
  </include>

</launch>
