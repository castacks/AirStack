# modules.repos : module pins for the rules_planner stack.
#
# vcstool format, PINNED to tags/commits (never branches). `airstack module sync`
# reads this file into the gitignored modules/ dir; a stack with a pinned .repos
# IS a localized release set.
#
# task_assigner is a LOCAL module while it is developed alongside this checkout
# (../task_assigner, the COA-SEI/task_assigner repo). Pin it under repositories:
# with a tag once it has releases.
airstack_compat: ">=0.21.0-dev.10 <0.22.0"
repositories:
  asm_mighty:
    type: git
    url: https://github.com/castacks/asm_mighty
    version: v0.1.5
x-local-modules:
- name: task_assigner
  path: ../task_assigner
