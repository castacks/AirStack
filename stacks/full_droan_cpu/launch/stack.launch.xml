<!--
  full_droan_cpu : trunk reference stack (RFC #379 S3, layout per RFC #385 S1).

  Preset absorbing the local_droan_cpu.launch.xml variant: identical to the
  full_default stack except the Local layer includes
  local_droan_cpu.launch.xml (CPU droan_local_planner + a live
  disparity_expansion world model) instead of local.launch.xml (GPU droan_gl).

  WRAP FORM: includes the existing layer bringups verbatim; flattening their
  nodes and remaps into this file arrives in E2/E3. This stack's wiring.md
  (generated by `airstack test -m wiring` with the stack flag) is the observed
  truth of the running graph.

  Launched by autonomy_bringup/launch/robot.launch.xml when AIRSTACK_STACK_DIR
  points at this folder (set by `airstack up` with the stack flag). The shared
  preamble (ROBOT_NAME namespace push, use_sim_time, robot_state_publisher,
  world/map static TF) runs there unconditionally, so it is NOT repeated here.

  Equivalence claim: launching this stack produces a ROS graph identical to
  legacy AUTONOMY_ROLE=full with
  local_launch_file:=local_droan_cpu.launch.xml.
-->
<launch>

  <!-- Autonomy layers -->

  <!-- Interface (MAVROS/PX4 hardware interface + safety) -->
  <include file="$(find-pkg-share interface_bringup)/launch/interface.launch.py" />

  <!-- Sensors -->
  <include file="$(find-pkg-share sensors_bringup)/launch/sensors.launch.xml" />

  <!-- Perception (stereo disparity + point cloud; macvo/natnet off by default) -->
  <include file="$(find-pkg-share perception_bringup)/launch/perception.launch.xml" />

  <!-- Local : CPU DROAN variant (droan_local_planner + disparity_expansion) -->
  <include file="$(find-pkg-share local_bringup)/launch/local_droan_cpu.launch.xml" />

  <!-- Global (global planner + world model) -->
  <include file="$(find-pkg-share global_bringup)/launch/global.launch.xml" />

  <!-- Behavior (behavior tree + safety monitor) -->
  <include file="$(find-pkg-share behavior_bringup)/launch/behavior.launch.xml" />

  <!-- Logging -->
  <include file="$(find-pkg-share logging_bringup)/launch/logging.launch.xml" />

  <!-- Role-full extras (from robot.launch.xml's full group) -->

  <!-- Domain Bridge (GCS) -->
  <include file="$(find-pkg-share autonomy_bringup)/launch/interpolate_dds_router.launch.py">
    <arg name="config_file"
      value="$(find-pkg-share autonomy_bringup)/onboard_all/config/dds_router.yaml" />
    <!-- 0 = robot.launch.xml's gcs_domain default -->
    <arg name="args" value="gcs_domain:=0" />
  </include>

  <!-- Gossip coordination layer -->
  <include file="$(find-pkg-share coordination_bringup)/launch/gossip.launch.xml">
    <!-- 99 / 1.0 = robot.launch.xml's gossip_domain / gossip_publish_rate defaults -->
    <arg name="gossip_domain" value="99" />
    <arg name="publish_rate" value="1.0" />
  </include>

</launch>
