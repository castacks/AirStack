<!--
  full_macvo : trunk reference stack (RFC #379 S3, layout per RFC #385 S1).

  Preset that absorbed (and FIXED) the deleted MAC-VO obstacle-avoidance
  local bringup variant (see README): full autonomy with MAC-VO as the
  disparity source for the local planner. Two include-line differences from
  full_default/launch/stack.launch.xml:
    1. Perception is included with launch_macvo:=true, so the macvo_ros2 node
       runs and publishes /$ROBOT_NAME/perception/macvo/disparity.
    2. The droan_gl include overrides its disparity arg to point at MAC-VO's
       real output topic instead of the canonical stereo_image_proc default.
  (The legacy variant file was broken: it passed arg names local.launch.xml
  never declared, and pointed at the stale /$ROBOT_NAME/macvo/disparity
  topic. It was deleted in P5-E2; the README records the details.)

  LOCAL LAYER FLATTENED (P5-E2): the Local layer is composed here as a flat
  set of module-launch includes — each block below reads "this module, these
  connections". Every module launch file declares its topic endpoints as args
  with canonical defaults (today's graph), so a bare include means "wired
  canonically"; only deviations from canonical appear as include args. The
  other layers remain wrapped (their bringup includes) until E3.

  Launched by autonomy_bringup/launch/robot.launch.xml when AIRSTACK_STACK_DIR
  points at this folder (set by `airstack up` with the stack flag). The shared
  preamble (ROBOT_NAME namespace push, use_sim_time, robot_state_publisher,
  world/map static TF) runs there unconditionally, so it is NOT repeated here.
-->
<launch>

  <!-- ── Wrapped layers (flatten in E3) ─────────────────────────────────── -->

  <!-- Interface (MAVROS/PX4 hardware interface + safety) -->
  <include file="$(find-pkg-share interface_bringup)/launch/interface.launch.py" />

  <!-- Sensors -->
  <include file="$(find-pkg-share sensors_bringup)/launch/sensors.launch.xml" />

  <!-- Perception : MAC-VO enabled (publishes perception/macvo/disparity) -->
  <include file="$(find-pkg-share perception_bringup)/launch/perception.launch.xml">
    <arg name="launch_macvo" value="true" />
  </include>

  <!-- ── Local layer, flat (module launch files; canonical defaults) ────── -->

  <!-- Takeoff/Land task server: odometry in from odometry_conversion;
       trajectory_override + mode out to the trajectory controller;
       arming/extended state from the interface; actions at tasks/{takeoff,land} -->
  <include file="$(find-pkg-share takeoff_landing_planner)/launch/takeoff_landing_planner.launch.xml" />

  <!-- Fixed-trajectory task server: trajectory_override + mode out to the
       trajectory controller; action at tasks/fixed_trajectory -->
  <include file="$(find-pkg-share trajectory_controller)/launch/fixed_trajectory_task.launch.xml" />

  <!-- DROAN local planner (GPU): disparity in from MAC-VO instead of the
       canonical stereo_image_proc topic — the one wiring deviation of this
       stack. global_plan in from the global planner, look_ahead /
       tracking_point in from the trajectory controller,
       trajectory_segment_to_add out to it; navigate action at tasks/navigate.
       (macvo_ros2 publishes no depth, so no depth wiring exists here.) -->
  <include file="$(find-pkg-share droan_gl)/launch/droan_gl.launch.xml">
    <arg name="droan_gl_disparity_topic"
      value="/$(env ROBOT_NAME)/perception/macvo/disparity" />
  </include>

  <!-- Trajectory controller: odometry in from odometry_conversion; serves the
       trajectory_controller/* topic group (override, segment, mode, tracking
       point, look_ahead) by relative name in its namespace -->
  <include file="$(find-pkg-share trajectory_controller)/launch/trajectory_controller.launch.xml" />

  <!-- PID controller: odometry in from odometry_conversion, tracking_point in
       from the trajectory controller; attitude/thrust command out to the
       interface (cmd_roll_pitch_yawrate_thrust) -->
  <include file="$(find-pkg-share pid_controller)/launch/pid_controller.launch.xml" />

  <!-- ── Wrapped layers (flatten in E3) ─────────────────────────────────── -->

  <!-- Global (global planner + world model) -->
  <include file="$(find-pkg-share global_bringup)/launch/global.launch.xml" />

  <!-- Behavior (behavior tree + safety monitor) -->
  <include file="$(find-pkg-share behavior_bringup)/launch/behavior.launch.xml" />

  <!-- Logging -->
  <include file="$(find-pkg-share logging_bringup)/launch/logging.launch.xml" />

  <!-- Role-full extras (from robot.launch.xml's full group) -->

  <!-- Domain Bridge (GCS) -->
  <include file="$(find-pkg-share autonomy_bringup)/launch/interpolate_dds_router.launch.py">
    <arg name="config_file"
      value="$(find-pkg-share autonomy_bringup)/onboard_all/config/dds_router.yaml" />
    <!-- 0 = robot.launch.xml's gcs_domain default -->
    <arg name="args" value="gcs_domain:=0" />
  </include>

  <!-- Gossip coordination layer -->
  <include file="$(find-pkg-share coordination_bringup)/launch/gossip.launch.xml">
    <!-- 99 / 1.0 = robot.launch.xml's gossip_domain / gossip_publish_rate defaults -->
    <arg name="gossip_domain" value="99" />
    <arg name="publish_rate" value="1.0" />
  </include>

</launch>
