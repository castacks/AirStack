<!--
  tigris_search : single-agent TIGRIS baseline search stack.

  The mtl_search stack with ONE module swapped: the global planner is
  tigris_search_planner (TIGRIS, receding horizon) instead of mtl_search_planner.
  Everything downstream is the same code, so a TIGRIS run and an MTL run are
  flown and scored identically:

    interface -> perception (keepalive) -> [takeoff/land, safety]
      -> tigris_search_planner  (/<robot>/search_mission action; search/plan revised in flight,
                                 search/planned_trajectory, search/planned_boresight, search/tigris_status)
      -> mtl_trajectory_follower (arc-length carrot pursuit + gimbal law, 20 Hz;
                                  accept_plan_revisions: true; the plan locks the gimbal = body-fixed camera)
      -> trajectory_controller / pid_controller
      -> mtl_metrics_logger (runs/<run_id>/<robot>/{telemetry.csv,detection.json,residual_belief.csv,report.html})

  ONE WIRING DEVIATION from canonical, identical to mtl_search: the trajectory
  controller's tracking point is moved to trajectory_controller/tracking_point_nominal
  and mtl_trajectory_follower owns the canonical trajectory_controller/tracking_point.

  The scenario bundle (scenario.json / ground_truth.json / belief.png) lives in
  this stack's config/ and is generated by scripts/tigris_generate_scenario.py
  from config/mission.yaml + config/fleets/tigris_search_fleet.yaml.
-->
<launch>
  <arg name="tigris_config_dir"
       default="$(env AIRSTACK_STACK_DIR /root/AirStack/stacks/tigris_search)/config"
       description="Folder holding the scenario bundle and the stack-local planner / follower / controller / DDS-router configs" />
  <arg name="tigris_runs_root"
       default="$(env MTL_RUNS_ROOT /root/AirStack/runs)"
       description="Where run folders (runs/RUN_ID/AGENT/...) are written; mounted from the repo's runs/ folder" />
  <arg name="gcs_domain" default="0"
       description="GCS ROS domain the DDS router bridges this robot's allowlisted topics to" />

  <!-- ── Interface (wrapped by design: MAVROS + safety boundary) ─────────── -->
  <include file="$(find-pkg-share interface_bringup)/launch/interface.launch.py" />

  <!-- ── Perception ──────────────────────────────────────────────────────── -->
  <include file="$(find-pkg-share perception_bringup)/launch/topic_keepalive.launch.xml" />

  <!-- ── Local tasks + behavior (canonical) ──────────────────────────────── -->
  <include file="$(find-pkg-share takeoff_landing_planner)/launch/takeoff_landing_planner.launch.xml" />
  <include file="$(find-pkg-share drone_safety_monitor)/launch/drone_safety_monitor.launch.xml" />

  <!-- ── Global: single-agent TIGRIS (receding horizon) ──────────────────── -->
  <include file="$(find-pkg-share tigris_search_planner)/launch/tigris_search_planner.launch.xml">
    <arg name="tigris_search_planner_config" value="$(var tigris_config_dir)/tigris_search_planner.yaml" />
    <arg name="tigris_search_planner_scenario_file" value="$(var tigris_config_dir)/scenario.json" />
    <arg name="tigris_search_planner_runs_root" value="$(var tigris_runs_root)" />
  </include>

  <!-- ── Local: search follower (tracking-point arbiter + gimbal law) ───── -->
  <include file="$(find-pkg-share mtl_trajectory_follower)/launch/mtl_trajectory_follower.launch.xml">
    <arg name="mtl_trajectory_follower_config" value="$(var tigris_config_dir)/mtl_trajectory_follower_tigris.yaml" />
  </include>

  <!-- Trajectory controller, with its tracking point MOVED to tracking_point_nominal -->
  <group>
    <set_remap from="/$(env ROBOT_NAME)/trajectory_controller/tracking_point"
               to="/$(env ROBOT_NAME)/trajectory_controller/tracking_point_nominal" />
    <include file="$(find-pkg-share trajectory_controller)/launch/trajectory_controller.launch.xml" />
  </group>

  <!-- PID controller: the stack-local gains lift the horizontal speed clamp to the plan speed (6 m/s) -->
  <include file="$(find-pkg-share pid_controller)/launch/pid_controller.launch.xml">
    <arg name="pid_controller_config" value="$(var tigris_config_dir)/pid_controller_tigris.yaml" />
  </include>

  <!-- ── Logging: online detection scoring + run report (identical to mtl_search) ── -->
  <include file="$(find-pkg-share mtl_metrics_logger)/launch/mtl_metrics_logger.launch.xml">
    <arg name="mtl_metrics_logger_scenario_file" value="$(var tigris_config_dir)/scenario.json" />
    <arg name="mtl_metrics_logger_runs_root" value="$(var tigris_runs_root)" />
  </include>

  <!-- ── Cross-domain extras ─────────────────────────────────────────────── -->
  <include file="$(find-pkg-share autonomy_bringup)/launch/interpolate_dds_router.launch.py">
    <arg name="dds_router_config_file" value="$(var tigris_config_dir)/dds_router_tigris_search.yaml" />
    <arg name="dds_router_args" value="gcs_domain:=$(var gcs_domain)" />
  </include>

  <include file="$(find-pkg-share coordination_bringup)/launch/gossip.launch.xml">
    <arg name="gossip_domain" value="99" />
    <arg name="gossip_publish_rate" value="1.0" />
  </include>
</launch>
