<!--
  lite_offload_global / onboard : the vehicle half of the split stack
  (RFC #380 S2 — a split is a stack shape: one entry file per host role plus
  an explicit bridge.yaml).

  Topology = lite_default's stack.launch.xml (interface, sensors, perception,
  flat Local layer, behavior — NO global, NO logging), with the DDS router
  configured from THIS stack's bridge.yaml: bridge.yaml is the single
  authoritative list of everything crossing the machine boundary, and
  tools/gen_dds_router.py turns it into the router config this entry loads.

  Regenerate the router config after editing bridge.yaml:

      python3 tools/gen_dds_router.py stacks/lite_offload_global/bridge.yaml

  Launched by autonomy_bringup/launch/robot.launch.xml on the VEHICLE when
  AIRSTACK_STACK_DIR points at this folder and AIRSTACK_STACK_ENTRY=onboard
  (`airstack up ...stack lite_offload_global:onboard`). The shared preamble
  (ROBOT_NAME namespace push, use_sim_time, robot_state_publisher, world/map
  static TF) runs there unconditionally, so it is NOT repeated here.

  SAFETY (RFC #379 S4 / #380 S2): the trajectory controller, PID controller,
  and safety executive below are ONBOARD-ONLY — link loss must leave the
  vehicle able to failsafe. control_setpoint and trajectory-group topics must
  never appear in bridge.yaml; `airstack doctor` hard-errors if they do.
-->
<launch>

  <!-- Path to the DDS-router config GENERATED from this stack's bridge.yaml.
       AIRSTACK_STACK_DIR is .../stacks/lite_offload_global (host or container),
       so ../../.airstack/generated/ is the checkout's generated dir. -->
  <arg name="dds_router_config_file"
       default="$(env AIRSTACK_STACK_DIR)/../../.airstack/generated/dds_router.lite_offload_global.yaml"
       description="DDS-router config for the onboard/offboard bridge; generated from this stack's bridge.yaml by tools/gen_dds_router.py — regenerate after editing bridge.yaml, never hand-edit the output" />

  <!-- ── Wrapped layers (flatten in a later phase) ──────────────────────── -->

  <!-- Interface (MAVROS/PX4 hardware interface + safety) -->
  <include file="$(find-pkg-share interface_bringup)/launch/interface.launch.py" />

  <!-- Sensors -->
  <include file="$(find-pkg-share sensors_bringup)/launch/sensors.launch.xml" />

  <!-- Perception (stereo disparity + point cloud; macvo off by default) -->
  <include file="$(find-pkg-share perception_bringup)/launch/perception.launch.xml" />

  <!-- ── Local layer, flat (module launch files; canonical defaults) ────── -->

  <!-- Takeoff/Land task server: odometry in from odometry_conversion;
       trajectory_override + mode out to the trajectory controller;
       arming/extended state from the interface; actions at tasks/{takeoff,land} -->
  <include file="$(find-pkg-share takeoff_landing_planner)/launch/takeoff_landing_planner.launch.xml" />

  <!-- Fixed-trajectory task server: trajectory_override + mode out to the
       trajectory controller; action at tasks/fixed_trajectory -->
  <include file="$(find-pkg-share trajectory_controller)/launch/fixed_trajectory_task.launch.xml" />

  <!-- DROAN local planner (GPU): disparity in from stereo_image_proc (canonical),
       global_plan in ACROSS THE BRIDGE from the offboard global planner,
       look_ahead/tracking_point in from the trajectory controller,
       trajectory_segment_to_add out to it; navigate action at tasks/navigate
       (goals arrive across the bridge from the offboard planner) -->
  <include file="$(find-pkg-share droan_gl)/launch/droan_gl.launch.xml" />

  <!-- Trajectory controller: odometry in from odometry_conversion; serves the
       trajectory_controller/* topic group (override, segment, mode, tracking
       point, look_ahead) by relative name in its namespace. ONBOARD-ONLY. -->
  <include file="$(find-pkg-share trajectory_controller)/launch/trajectory_controller.launch.xml" />

  <!-- PID controller: odometry in from odometry_conversion, tracking_point in
       from the trajectory controller; attitude/thrust command out to the
       interface (cmd_roll_pitch_yawrate_thrust). ONBOARD-ONLY. -->
  <include file="$(find-pkg-share pid_controller)/launch/pid_controller.launch.xml" />

  <!-- ── Wrapped layers (flatten in a later phase) ──────────────────────── -->

  <!-- Behavior (behavior tree + safety monitor). The safety executive is
       ONBOARD-ONLY per RFC #380 S2. -->
  <include file="$(find-pkg-share behavior_bringup)/launch/behavior.launch.xml" />

  <!-- NO global layer onboard — vdb_mapping + random_walk run on the offboard
       host (launch/offboard.launch.xml). NO logging layer (lite). -->

  <!-- ── The bridge (this stack's defining feature) ─────────────────────── -->

  <!-- DDS Router: bridges exactly the topics/services/actions listed in this
       stack's bridge.yaml between the robot domain and the offboard host's
       domain. gcs_domain:=0 = the conventional ground/offboard domain (matches
       robot.launch.xml's gcs_domain default). -->
  <include file="$(find-pkg-share autonomy_bringup)/launch/interpolate_dds_router.launch.py">
    <arg name="dds_router_config_file" value="$(var dds_router_config_file)" />
    <arg name="dds_router_args" value="gcs_domain:=0" />
  </include>

  <!-- Gossip coordination layer -->
  <include file="$(find-pkg-share coordination_bringup)/launch/gossip.launch.xml">
    <!-- 99 / 1.0 = robot.launch.xml's gossip_domain / gossip_publish_rate defaults -->
    <arg name="gossip_domain" value="99" />
    <arg name="gossip_publish_rate" value="1.0" />
  </include>

</launch>
