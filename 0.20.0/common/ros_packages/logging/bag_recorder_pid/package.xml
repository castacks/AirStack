<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bag_record_pid</name>
  <version>0.0.0</version>
  <description>ROS 2 node for recording MCAP bag files with runtime start/stop control via topics, multiple concurrent recording sections, and namespaced-topic support.</description>
  <maintainer email="ajong@andrew.cmu.edu">Andrew Jong</maintainer>
  <license>BSD-3-Clause-Clear</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
